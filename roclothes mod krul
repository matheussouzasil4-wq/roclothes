	function Function._LoadVnsAndInstallSmartBone_Inner()
		local CG = game:GetService("CoreGui")
		local SS = game:GetService("SerializationService")
		local _gca = getcustomasset or getsynasset
		local vnsRoot = CG:FindFirstChild("_RCVns")
		local function _hasModuleScript(inst)
			if not inst then return false end
			if inst:IsA("ModuleScript") then return true end
			return inst:FindFirstChildWhichIsA("ModuleScript", true) ~= nil
		end
		if vnsRoot and not _hasModuleScript(vnsRoot) then
			pcall(function() vnsRoot:Destroy() end); vnsRoot = nil
		end
		if not vnsRoot and _gca and env.isfile and env.isfile(VNS_CACHE) then
			local okU, customUrl = pcall(_gca, VNS_CACHE)
			if okU and type(customUrl) == "string" and #customUrl > 0 then
				local okG, objects = pcall(game.GetObjects, game, customUrl)
				if okG and objects and #objects > 0 and _hasModuleScript(objects[1]) then
					vnsRoot = objects[1]
				end
			end
		end
		if not vnsRoot then
			local okG, objects = pcall(game.GetObjects, game, "rbxasset://" .. VNS_LOCAL_PATH)
			if okG and objects and #objects > 0 and _hasModuleScript(objects[1]) then
				vnsRoot = objects[1]
			end
		end
		if not vnsRoot then
			local raw
			if env.isfile and env.isfile(VNS_CACHE) then
				local okR, data = pcall(env.readfile, VNS_CACHE)
				if okR and type(data) == "string" and #data > 1000 then raw = data end
			end
			if not raw then
				local ok, data = pcall(game.HttpGet, game, VNS_URL)
				if ok and type(data) == "string" and #data > 1000 then
					raw = data
					if env.writefile then
						if env.makefolder and env.isfolder and not env.isfolder(VNS_CACHE_DIR) then
							pcall(env.makefolder, VNS_CACHE_DIR)
						end
						pcall(env.writefile, VNS_CACHE, raw)
					end
				end
			end
			if raw and buffer then
				local okD, instances = pcall(function()
					return SS:DeserializeInstancesAsync(buffer.fromstring(raw))
				end)
				if okD and instances and #instances > 0 then
					for _, inst in ipairs(instances) do
						if _hasModuleScript(inst) then vnsRoot = inst; break end
					end
				end
			end
		end
		if not vnsRoot then error("vns.rbxm could not be loaded") end
		vnsRoot.Name = "_RCVns"
		if vnsRoot.Parent ~= CG then pcall(function() vnsRoot.Parent = CG end) end
		System._sbFolder = vnsRoot
		local _moduleCache = {}
		local _customRequire
		local function _resolvePath(path, base)
			if typeof(path) == "Instance" then return path end
			if type(path) ~= "string" then return nil end
			local current, remaining = nil, path
			local prefixes = {
				{ "@self", function(b) return b end },
				{ "@game", function(_) return game end },
				{ "..",    function(b) return b.Parent and b.Parent.Parent or nil end },
				{ ".",     function(b) return b.Parent end },
			}
			while true do
				local matched = false
				for _, e in ipairs(prefixes) do
					local key, fn = e[1], e[2]
					if remaining:sub(1, #key) == key
					   and (#remaining == #key or remaining:sub(#key + 1, #key + 1) == "/") then
						current = fn(base)
						remaining = (#remaining == #key) and "" or remaining:sub(#key + 2)
						matched = true; break
					end
				end
				if not matched then break end
			end
			if not current then return nil end
			for segment in string.gmatch(remaining, "[^/]+") do
				if segment == ".." then current = current and current.Parent
				else current = current and current:FindFirstChild(segment) end
				if not current then return nil end
			end
			return current
		end
		_customRequire = function(module)
			if _moduleCache[module] then return _moduleCache[module] end
			local chunk, lerr = loadstring(module.Source, module.Name)
			if not chunk then error("loadstring failed for "..tostring(module.Name)..": "..tostring(lerr)) end
			local moduleEnv = {}
			moduleEnv.script = module
			moduleEnv.require = function(target)
				if typeof(target) == "Instance" and target:IsA("ModuleScript") then
					return _customRequire(target)
				end
				if type(target) == "string" then
					local resolved = _resolvePath(target, module)
					if not resolved then error("path resolve failed: "..tostring(target)) end
					if resolved:IsA("ModuleScript") then return _customRequire(resolved) end
					return require(resolved)
				end
				return require(target)
			end
			moduleEnv.task = setmetatable({
				synchronize = function() end,
				desynchronize = function() end,
			}, { __index = task })
			pcall(function() setmetatable(moduleEnv, { __index = getfenv(chunk) }) end)
			pcall(setfenv, chunk, moduleEnv)
			local ok, result = pcall(chunk)
			if not ok then error("module "..tostring(module.Name).." errored: "..tostring(result)) end
			if module:IsA("ModuleScript") then _moduleCache[module] = result end
			return result
		end
		local vnsModule = vnsRoot:IsA("ModuleScript") and vnsRoot
			or vnsRoot:FindFirstChild("vns") or vnsRoot:FindFirstChildWhichIsA("ModuleScript")
		if not vnsModule then error("no entry ModuleScript in vns.rbxm") end
		do
			local genv = (getgenv and getgenv()) or _G
			pcall(function() genv.vns = vnsModule end)
		end
		local moduleAggr = vnsModule:FindFirstChild("module")
		if not moduleAggr then error("vns module aggregator missing") end
		local envMod = moduleAggr:FindFirstChild("env")
		if envMod then
			local _envSub = _customRequire(envMod)
			if _envSub and _envSub.g then
				_envSub.g.vns = vnsModule
				_envSub.g.inject = true  
			end
		end
		local contentMod = moduleAggr:FindFirstChild("content")
		if contentMod then
			local okC, content = pcall(_customRequire, contentMod)
			if okC and type(content) == "table" then
				content.folder = "RClothesContent/_vns"
				if type(content.checkVersion) == "function" then
					content.checkVersion = function() return true end
				end
				local _origLoadRbxm = content.loadRbxm
				content.loadRbxm = function(self, path)
					local workspacePath = self.folder .. "/" .. path
					if _gca and System.isfile and System.isfile(workspacePath) then
						local okU, customUrl = pcall(_gca, workspacePath)
						if okU and type(customUrl) == "string" and #customUrl > 0 then
							local okG, objects = pcall(game.GetObjects, game, customUrl)
							if okG and objects and #objects > 0 then return objects end
						end
					end
					local okG2, objects2 = pcall(game.GetObjects, game, "rbxasset://" .. workspacePath)
					if okG2 and objects2 and #objects2 > 0 then return objects2 end
					return _origLoadRbxm(self, path)
				end
			end
		end
		do
			local cfgMod = vnsModule:FindFirstChild("config")
			if cfgMod then
				local okCfg, cfg = pcall(_customRequire, cfgMod)
				if okCfg and type(cfg) == "table" then
					cfg.debug = false
				end
			end
		end
		local sbMod = moduleAggr:FindFirstChild("smartbone")
		if not sbMod then error("vns.module.smartbone missing") end
		local smartbone = _customRequire(sbMod)
		if type(smartbone) ~= "table" or type(smartbone.install) ~= "function" then
			error("smartbone module didn't return install()")
		end
		smartbone:install()
		local variableMod = vnsModule:FindFirstChild("variable")
		if variableMod then
			local _vsub = _customRequire(variableMod)
			if _vsub and _vsub.smartboneTag then
				System._sbTag = _vsub.smartboneTag
			end
		end
		System._vnsApi = nil  
		System._sbApi = smartbone  
	end
