											table.remove(PlayerData[SelectPlayer].CatalogAccessory, i)
											break  
										end
									end
									Button:Destroy()
									AccessoryButtonConnect:Disconnect()
									hotSwap()
								end)
								table.insert(AllConnect, AccessoryButtonConnect)
