local function _buildColorPickerPanel(Function, GUIObject, UIS, GlobalMaid)
	local cpState = {
		hue = 0,
		sat = 1,
		val = 1,
		draggingSV = false,
		draggingHue = false,
		callback = nil,
	}
	local function cpRefreshPreview()
		local colour = Color3.fromHSV(cpState.hue, cpState.sat, cpState.val)
		local r, g, b = math.round(colour.R * 255), math.round(colour.G * 255), math.round(colour.B * 255)
		GUIObject.ColorPickerPreview.BackgroundColor3 = colour
		GUIObject.ColorPickerRGBLabel.Text = string.format("R: %d  G: %d  B: %d", r, g, b)
		GUIObject.ColorPickerHexLabel.Text = string.format("#%02X%02X%02X", r, g, b)
		local pureHue = Color3.fromHSV(cpState.hue, 1, 1)
		GUIObject.ColorPickerSVWhite.BackgroundColor3 = pureHue
		GUIObject.ColorPickerSVCursor.Position = UDim2.new(cpState.sat, 0, 1 - cpState.val, 0)
		GUIObject.ColorPickerHueCursor.Position = UDim2.new(0, -2, cpState.hue, 0)
	end
	local function cpUpdateSV(input)
		local frame = GUIObject.ColorPickerSVFrame
		local absPos = frame.AbsolutePosition
		local absSize = frame.AbsoluteSize
		if absSize.X <= 0 or absSize.Y <= 0 then return end
		local relX = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
		local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
		cpState.sat = relX
		cpState.val = 1 - relY
		cpRefreshPreview()
	end
	local function cpUpdateHue(input)
		local frame = GUIObject.ColorPickerHueStrip
		local absPos = frame.AbsolutePosition
		local absSize = frame.AbsoluteSize
		if absSize.Y <= 0 then return end
		local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
		cpState.hue = relY
		cpRefreshPreview()
	end
	GlobalMaid:Give(GUIObject.ColorPickerSVBlack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			cpState.draggingSV = true
			cpUpdateSV(input)
		end
	end))
	GlobalMaid:Give(GUIObject.ColorPickerHueStrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			cpState.draggingHue = true
			cpUpdateHue(input)
		end
	end))
	GlobalMaid:Give(UIS.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			if cpState.draggingSV then
				cpUpdateSV(input)
			elseif cpState.draggingHue then
				cpUpdateHue(input)
			end
		end
	end))
