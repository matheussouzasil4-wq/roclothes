					if type(hpType) == "table" and (hpType.HP == "TopHP" or hpType.HP == "BottomHP") then
						PlayerData[SelectPlayer].AccessoryHP[accName] = {HP = hpType.HP, Inverse = hpType.Inverse == true}
					elseif type(hpType) == "number" and hpType > 0 then
						PlayerData[SelectPlayer].AccessoryHP[accName] = hpType
