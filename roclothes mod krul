					if okR and res and type(res.Body) == "string" and #res.Body >= (minBytes or 2) then
						ok, body = true, res.Body
					end
				end
			end
			if not ok or type(body) ~= "string" or #body < (minBytes or 2) then
				return nil, "fetch failed: " .. tostring(body)
			end
			local okD, decoded = pcall(HttpService.JSONDecode, HttpService, body)
			if not okD or type(decoded) ~= "table" then
