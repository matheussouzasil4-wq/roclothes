					if _existing then _existing:Destroy() end
					DataList.OldestClothings.HeadDecal:Clone().Parent = _restoreHead
					DataList.OldestClothings.HeadDecal = nil
				end
				if DataList.OldestClothings.HeadSpecialMesh and _restoreHead then
					local _existing = _restoreHead:FindFirstChildOfClass("SpecialMesh")
					if _existing then _existing:Destroy() end
					DataList.OldestClothings.HeadSpecialMesh:Clone().Parent = _restoreHead
					DataList.OldestClothings.HeadSpecialMesh = nil
				end
			else
				DataList.OldestClothings.Shirt = nil
				DataList.OldestClothings.Pants = nil
				DataList.OldestClothings.ShirtGraphic = nil
				DataList.OldestClothings.HeadDecal = nil
				DataList.OldestClothings.HeadSpecialMesh = nil
			end
		end
