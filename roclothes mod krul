		local function _buildOutfitPreset(pd, stripCats)
			if not pd then return {} end
			local preset = {
				CatalogClothes = {
					Shirt        = pd.CatalogClothes and pd.CatalogClothes.Shirt or "",
					Pants        = pd.CatalogClothes and pd.CatalogClothes.Pants or "",
					ShirtGraphic = pd.CatalogClothes and pd.CatalogClothes.ShirtGraphic or "",
				},
				CatalogAccessory = {},
				CatalogTail      = {},
				CatalogOutfitId  = pd.CatalogOutfitId or "",
				BodyPartPhysics  = pd.BodyPartPhysics == true,
			}
			if pd.CatalogAccessory then for _, v in ipairs(pd.CatalogAccessory) do table.insert(preset.CatalogAccessory, v) end end
			if pd.CatalogTail      then for _, v in ipairs(pd.CatalogTail)      do table.insert(preset.CatalogTail,      v) end end
			preset.CatalogAssetTypes = {}
			if Function._catalogAssetTypeCache then
				local function _capture(id)
					if not id then return end
					local _key = tonumber(id) or id
					local _t = Function._catalogAssetTypeCache[_key]
					if _t then preset.CatalogAssetTypes[tostring(id)] = _t end
				end
				if pd.CatalogAccessory then for _, v in ipairs(pd.CatalogAccessory) do _capture(v) end end
				if pd.CatalogTail      then for _, v in ipairs(pd.CatalogTail)      do _capture(v) end end
			end
			if pd.BreastsType    and pd.BreastsType    ~= 1       then preset.BreastsType    = pd.BreastsType    end
			local function _shallowClone(t) local _o = {}; for k, v in pairs(t) do _o[k] = v end; return _o end
			local function _depth2Clone(t) local _o = {}; for k, v in pairs(t) do _o[k] = (type(v) == "table") and _shallowClone(v) or v end; return _o end
			if pd.ClothesHP and next(pd.ClothesHP) then
				preset.ClothesHP = _shallowClone(pd.ClothesHP)
			end
			if pd.ClothesRecolor and next(pd.ClothesRecolor) then
				preset.ClothesRecolor = _depth2Clone(pd.ClothesRecolor)  
			end
			if pd.AccessoryHP and next(pd.AccessoryHP) then
				preset.AccessoryHP = _shallowClone(pd.AccessoryHP)
			end
			if pd.GizmoOffsets and next(pd.GizmoOffsets) then
				preset.GizmoOffsets = _depth2Clone(pd.GizmoOffsets)  
			end
			if pd.GizmoPresets and next(pd.GizmoPresets) then
				preset.GizmoPresets = _depth2Clone(pd.GizmoPresets)
			end
			if pd.TorsoType      and pd.TorsoType      ~= 1       then preset.TorsoType      = pd.TorsoType      end
			if pd.ArmType        and pd.ArmType        ~= 1       then preset.ArmType        = pd.ArmType        end
			if pd.LegsType       and pd.LegsType       ~= 1       then preset.LegsType       = pd.LegsType       end
			if pd.ButtType       and pd.ButtType       ~= 1       then preset.ButtType       = pd.ButtType       end
			if pd.BreastsScale   and pd.BreastsScale   ~= 1       then preset.BreastsScale   = pd.BreastsScale   end
			if pd.ButtsScale     and pd.ButtsScale     ~= 1       then preset.ButtsScale     = pd.ButtsScale     end
			if pd.LegsScale      and pd.LegsScale      ~= 1       then preset.LegsScale      = pd.LegsScale      end
			if pd.CockScale      and pd.CockScale      ~= 1       then preset.CockScale      = pd.CockScale      end
			if pd.Tone           and pd.Tone           ~= "Base"  then preset.Tone           = pd.Tone           end
			if pd.HardcoreHP                                       then preset.HardcoreHP    = true              end
			if pd.TopHP          and pd.TopHP          ~= ""      then preset.TopHP         = pd.TopHP          end
			if pd.BottomHP       and pd.BottomHP       ~= ""      then preset.BottomHP      = pd.BottomHP       end
			if pd.DamageSFX      and pd.DamageSFX      ~= ""      then preset.DamageSFX     = pd.DamageSFX      end
			if pd.Volume         and pd.Volume         ~= 1       then preset.Volume        = pd.Volume         end
			if pd.TearParticles  == false                          then preset.TearParticles = false             end
			if pd.HealParticles  == false                          then preset.HealParticles = false             end
			if pd.RealtimeBodyTransparency == false                then preset.RealtimeBodyTransparency = false  end
			if pd.Face           == false                          then preset.Face          = false             end
			if pd.PhysicsObeyGravity == false                      then preset.PhysicsObeyGravity = false        end
			if pd.AccessorySizeLock                                then preset.AccessorySizeLock = true          end
