	function Function.ApplyAssets(Root)
		local function _trySet(inst, prop, val)
			pcall(function() inst[prop] = val end)
		end
		for _, v in pairs(Root:GetDescendants() or {}) do
			if v:IsA("MeshPart") then
				_trySet(v, "MeshId",    Function.GetAsset(v.MeshId))
				_trySet(v, "TextureID", Function.GetAsset(v.TextureID))
			elseif v:IsA("SpecialMesh") then
				_trySet(v, "MeshId",    Function.GetAsset(v.MeshId))
				_trySet(v, "TextureId", Function.GetAsset(v.TextureId))
			elseif v:IsA("Decal") or v:IsA("Texture") then
				_trySet(v, "Texture", Function.GetAsset(v.Texture))
			elseif v:IsA("ImageLabel") or v:IsA("ImageButton") then
				_trySet(v, "Image", Function.GetAsset(v.Image))
			end
		end
		if Root:IsA("MeshPart") then
			_trySet(Root, "MeshId",    Function.GetAsset(Root.MeshId))
			_trySet(Root, "TextureID", Function.GetAsset(Root.TextureID))
		elseif Root:IsA("SpecialMesh") then
			_trySet(Root, "MeshId",    Function.GetAsset(Root.MeshId))
			_trySet(Root, "TextureId", Function.GetAsset(Root.TextureId))
		end
	end
