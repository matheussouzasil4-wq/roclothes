								and propVal.R == propVal.R and propVal.G == propVal.G and propVal.B == propVal.B then
								local rgb = Function.StringTo(tostring(propVal.R * 255 .. "," .. propVal.G * 255 .. "," .. propVal.B * 255), "RGB")
								pd.PartList[partName][propName].Color = rgb
							end
						end
					else
						if pd.PartList[partName] then
							local _safe, _ok = Function.SanitizeMeshEditValue(propName, propVal)
							if _ok then pd.PartList[partName][propName] = _safe end
						end
					end
				end
			end
		end
		if bundleData.HPClothes then
			for cname, val in pairs(bundleData.HPClothes) do
				if type(val) == "table" then
					if val.HP == "TopHP" or val.HP == "BottomHP" then
						pd.ClothesHP[cname] = {HP = val.HP, Inverse = val.Inverse == true}
