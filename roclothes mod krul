			local function _cb_pushHistory(pd, item)
				if not (pd and item and item.id) then return end
				pd.CatalogHistory = pd.CatalogHistory or {}
				for i = #pd.CatalogHistory, 1, -1 do
					if pd.CatalogHistory[i] and pd.CatalogHistory[i].id == item.id then
						table.remove(pd.CatalogHistory, i)
					end
				end
				table.insert(pd.CatalogHistory, 1, {
					id = item.id, name = item.name, assetType = item.assetType,
					itemType = item.itemType, priceInRobux = item.priceInRobux,
				})
				while #pd.CatalogHistory > 20 do table.remove(pd.CatalogHistory) end
			end
			local function _cb_applyTap(item)
				local pd = PlayerData[SelectPlayer]
				if not pd then return end
				if item.itemType ~= "Bundle" and type(item.assetType) ~= "number" then
					local d = Function.CatalogFetchAssetDetails(item.id)
					if d then
						if d.name      then item.name = d.name end
						if d.price     then item.priceInRobux = d.price end
						if d.assetType then item.assetType = d.assetType end
					end
				end
				if item.itemType ~= "Bundle" and type(item.assetType) == "number" then
					Function._catalogAssetTypeCache[tonumber(item.id) or item.id] = item.assetType
				end
				local alreadyEquipped = _cb_isEquipped(item, pd)
				if alreadyEquipped then
					if item.itemType == "Bundle" then
						pd.CatalogOutfitId = ""
						pd.CatalogRemove = {}
						if GUIObject.OutfitIdTextbox then
							GUIObject.OutfitIdTextbox.Text = ""
						end
						if pd.CurrentClothes then
							for _, _name in ipairs({"Roblox Shirt", "Roblox Pants"}) do
								local _idx = table.find(pd.CurrentClothes, _name)
								if _idx then table.remove(pd.CurrentClothes, _idx) end
							end
						end
						local _myList = GUIObject.Catalog_3:FindFirstChild(SelectPlayer)
						if _myList then
							for _, v in pairs(_myList:GetChildren()) do
								if not v:IsA("UIGridLayout")
								   and not table.find(pd.CatalogAccessory, tonumber(v.Name))
								   and not table.find(pd.CatalogTail or {}, tonumber(v.Name)) then
									v:Destroy()
								end
							end
						end
					else
						local atyp = item.assetType
						local function _removeFromCurrent(_name)
							if pd.CurrentClothes then
								local _idx = table.find(pd.CurrentClothes, _name)
								if _idx then table.remove(pd.CurrentClothes, _idx) end
							end
						end
						if atyp == 11 then
							if pd.CatalogClothes then pd.CatalogClothes.Shirt = "" end
							_removeFromCurrent("Roblox Shirt")
						elseif atyp == 12 then
							if pd.CatalogClothes then pd.CatalogClothes.Pants = "" end
							_removeFromCurrent("Roblox Pants")
						elseif atyp == 2 then
							if pd.CatalogClothes then pd.CatalogClothes.ShirtGraphic = "" end
							_removeFromCurrent("Roblox Shirt")  
						elseif Function.CatalogIsAccessoryAssetType(atyp) then
							local idNum = tonumber(item.id)
							if pd.CatalogAccessory and idNum then
								for i, v in ipairs(pd.CatalogAccessory) do
									if tonumber(v) == idNum then
										table.remove(pd.CatalogAccessory, i)
										break
									end
								end
								local _myList = GUIObject.Catalog_3:FindFirstChild(SelectPlayer)
								if _myList then
									local existing = _myList:FindFirstChild(tostring(idNum))
									if existing then existing:Destroy() end
								end
							end
						end
					end
					hotSwap()
					_cb_refreshAllCells()
					_cb_renderEquippedPanel()  
					return
				end
				if item.itemType == "Bundle" then
					local function _ensureClothBundle(name)
						pd.CurrentClothes = pd.CurrentClothes or {}
						if not table.find(pd.CurrentClothes, name) then
							table.insert(pd.CurrentClothes, name)
						end
					end
					_ensureClothBundle("Roblox Shirt")
					_ensureClothBundle("Roblox Pants")
					local outfitText = tostring(item.id)
					pd.CatalogOutfitId = outfitText
					if GUIObject.OutfitIdTextbox then
						GUIObject.OutfitIdTextbox.Text = outfitText
					end
					pd.CatalogRemove = {}
					local _myList = GUIObject.Catalog_3:FindFirstChild(SelectPlayer)
					if _myList then
						for _, v in pairs(_myList:GetChildren()) do
							if not v:IsA("UIGridLayout")
							   and not table.find(pd.CatalogAccessory, tonumber(v.Name))
							   and not table.find(pd.CatalogTail or {}, tonumber(v.Name)) then
								v:Destroy()
							end
						end
					end
					pcall(function()
						local hd = PS:GetHumanoidDescriptionFromOutfitId(outfitText)
						for _, accessory in pairs(hd:GetAccessories(true)) do
							task.spawn(function()
								if accessory then
									local info = MPS:GetProductInfo(accessory.AssetId)
									local listFrame = GUIObject.Catalog_3:FindFirstChild(SelectPlayer)
									if not listFrame then return end
									local Button = Function.ButtonCreate(info.Name, listFrame)
									local _conn
									_conn = Button:FindFirstChildOfClass("TextButton").MouseButton1Click:Connect(function()
										if not table.find(pd.CatalogRemove, accessory.AssetId) then
											table.insert(pd.CatalogRemove, accessory.AssetId)
										end
										Button:Destroy()
										local _idx = table.find(AllConnect, _conn)
										if _idx then table.remove(AllConnect, _idx) end
										_conn:Disconnect()
										hotSwap()
									end)
									table.insert(AllConnect, _conn)
								end
							end)
						end
					end)
				else
					local atyp = item.assetType
					local function _ensureCloth(name)
						pd.CurrentClothes = pd.CurrentClothes or {}
						if not table.find(pd.CurrentClothes, name) then
							table.insert(pd.CurrentClothes, name)
						end
					end
					if atyp == 11 then
						pd.CatalogClothes = pd.CatalogClothes or {}
						pd.CatalogClothes.Shirt = tostring(item.id)
						_ensureCloth("Roblox Shirt")
					elseif atyp == 12 then
						pd.CatalogClothes = pd.CatalogClothes or {}
						pd.CatalogClothes.Pants = tostring(item.id)
						_ensureCloth("Roblox Pants")
					elseif atyp == 2 then
						pd.CatalogClothes = pd.CatalogClothes or {}
						pd.CatalogClothes.ShirtGraphic = tostring(item.id)
						_ensureCloth("Roblox Shirt")
					elseif Function.CatalogIsAccessoryAssetType(atyp) then
						pd.CatalogAccessory = pd.CatalogAccessory or {}
						local idNum = tonumber(item.id)
						local dup = false
						for _, existing in ipairs(pd.CatalogAccessory) do
							local a, b = tonumber(existing), idNum
							if a and b and a == b then dup = true; break end
						end
						if not dup and idNum then
							table.insert(pd.CatalogAccessory, idNum)
							local listFrame = GUIObject.Catalog_3:FindFirstChild(SelectPlayer)
							if listFrame then
								local Button = Function.ButtonCreate(tostring(idNum), listFrame)
								if Button then
									local _conn
									_conn = Button:FindFirstChildOfClass("TextButton").MouseButton1Click:Connect(function()
										for i, v in ipairs(pd.CatalogAccessory) do
											if tonumber(v) == idNum then
												table.remove(pd.CatalogAccessory, i)
												break
											end
										end
										Button:Destroy()
										local _idx = table.find(AllConnect, _conn)
										if _idx then table.remove(AllConnect, _idx) end
										_conn:Disconnect()
										hotSwap()
									end)
									table.insert(AllConnect, _conn)
								end
							end
						end
					else
						warn("[RoClothes] catalog tap: unmapped assetType " .. tostring(atyp))
						return
					end
				end
				_cb_pushHistory(pd, item)
				hotSwap()
				_cb_refreshAllCells()  
				_cb_renderEquippedPanel()  
			end
