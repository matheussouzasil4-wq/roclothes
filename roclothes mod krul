	local function dehydrate(node)
		local tv = typeof(node)
		if tv == "Vector3" then
			return {__t = "V3", v = {node.X, node.Y, node.Z}}
		elseif tv == "CFrame" then
			return {__t = "CF", v = {node:GetComponents()}}
		elseif tv == "Color3" then
			return {__t = "C3n", v = {node.R, node.G, node.B}}
		elseif tv == "EnumItem" then
			return {__t = "E", p = tostring(node.EnumType):sub(6), v = node.Name}
		elseif tv ~= "table" then
			return node
		end
		local out = {}
		for k, val in pairs(node) do
			local sk
			if type(k) == "number" then
