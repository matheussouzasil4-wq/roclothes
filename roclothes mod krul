	function Function.RunInitialization()
		do
			local _CS = game:GetService("CollectionService")
			local _allTags = _CS.GetAllTags and _CS:GetAllTags() or nil
			if _allTags then
				for _, _tag in ipairs(_allTags) do
					if type(_tag) == "string" and _tag:sub(1, 3) == "rc_" then
						for _, v in ipairs(_CS:GetTagged(_tag)) do
							pcall(function() v:Destroy() end)
						end
					end
				end
			else
				for _, v in ipairs(_CS:GetTagged(System.RCTag)) do
					pcall(function() v:Destroy() end)
				end
			end
		end
		local loadui = _sharedLoadui or Instance.new("ScreenGui", game:GetService("CoreGui"))
		_sharedLoadui = nil
		loadui.Enabled = true
		local load = loadui:FindFirstChildOfClass("ImageLabel")
		if not load then
			load = Instance.new("ImageLabel", loadui)
			local okLoad, loadAsset = pcall(System.getcustomasset, "RClothesContent/loadv9.png")
			load.Image = okLoad and loadAsset or ""
			load.Size = UDim2.new(1,0,1,0)
			load.Transparency = 1
			load.ImageTransparency = .999
		end
		local okLoad = load.Image ~= ""
		local debounce_load = 0
		local loadtxt
		repeat
			task.wait(.1)
			if loadtxt then
				loadtxt:Destroy()
			end
			loadtxt = Instance.new("TextLabel", loadui)
			loadtxt.BackgroundTransparency = 1
			loadtxt.TextColor3 = Color3.new(1,1,1)
			loadtxt.TextScaled = true
			loadtxt.Size = UDim2.new(1,0,1,0)
			loadtxt.Text = "loading"
			debounce_load += 1
		until debounce_load >= 10 or load.IsLoaded == true or not okLoad
		if loadtxt then
			loadtxt:Destroy()
		end
		if load.IsLoaded == false then
			warn("[RoClothes] Assets are not fully loaded yet. GUI may appear incomplete until files are found.")
		end
		task.spawn(function() pcall(Function.LoadSmartBoneApi) end)
		do
			if loadupFPerson > 0 then
				PlayerData[Player.Name].FPerson = true
				if loadupFPerson == 3 or loadupFPerson == 4 then
					PlayerData[Player.Name].FPsnap = true
				end
				if loadupFPerson == 5 or loadupFPerson == 6 then
					PlayerData[Player.Name].HeadTracking = false
				end
				if loadupFPerson == 1 or loadupFPerson == 3 or loadupFPerson == 5 then
					PlayerData[Player.Name].LocalTransparency = {
						["Head"] = false,
						["Right Arm"] = true,
						["Left Arm"] = true,
						["Torso"] = true,
						["Right Leg"] = true,
						["Left Leg"] = true,
						["Hat"] = true
					}
				end
			end
			if loadupClosed == false then
				GUIObject.Screen.Enabled = true
			end
			if loadupExecute == true and Player.Character then
				local InitialID = PlayerData[Player.Name].LastRequestID
				Function.CharacterExecute(Player.Character, Player.Name, nil, InitialID)
				Function.AvatarSyncPublish(true)
			end
			loadui:Destroy()
			local CLOTHING_DIR = "RClothesContent/KrulClothing"
			if env.isfolder and env.makefolder and not env.isfolder(CLOTHING_DIR) then
				pcall(env.makefolder, CLOTHING_DIR)
			end
			System._krulManifestStop = false
			System._krulManifestTask = task.spawn(function()
				local CLOTHING_BASE = "https://krulhub.dev/roclothes/clothing/"
				local ok, body = false, nil
				for attempt = 1, 3 do
					ok, body = pcall(game.HttpGet, game, CLOTHING_BASE .. "manifest.json")
					if ok and type(body) == "string" and #body > 0 then break end
					task.wait(1.5 * attempt)
				end
				if not ok or type(body) ~= "string" then return end
				local okD, manifest = pcall(game:GetService("HttpService").JSONDecode,
					game:GetService("HttpService"), body)
				if not okD or type(manifest) ~= "table" then return end
				for _, filename in ipairs(manifest) do
					if System._krulManifestStop then return end  
					if type(filename) ~= "string" then continue end 
					local localPath = CLOTHING_DIR .. "/" .. filename
					if env.isfile and not env.isfile(localPath) then
						local okH, data = pcall(game.HttpGet, game, CLOTHING_BASE .. filename)
						if okH and type(data) == "string" and #data > 100 and data:sub(1,4) == "\x89PNG" then
							if env.writefile then pcall(env.writefile, localPath, data) end
						end
					end
					local clothName = filename:match("^(.-)%.png$") or filename
					local _fileReady = env.isfile and env.isfile(localPath)
					if Clothes and not Clothes[clothName] and _fileReady then
						local isShirt = clothName:lower():find("shirt") ~= nil
						local isPants = clothName:lower():find("pant") ~= nil
						if isShirt or isPants then
							Clothes[clothName] = setmetatable({
								ClothType = isShirt and "Shirt" or "Pants",
								LocalPath = localPath,
								KrulHosted = true,
							}, MetaClothes)
							if GUIObject and GUIObject.ClothesButtonFrame then
								local btn = Function.ButtonCreate(clothName, GUIObject.ClothesButtonFrame)
								if btn and btn:FindFirstChildOfClass("TextButton") then
									btn:SetAttribute("KrulHosted", true)
									local conn = btn:FindFirstChildOfClass("TextButton").MouseButton1Click:Connect(function()
										if not PlayerData[SelectPlayer] then return end
										if table.find(PlayerData[SelectPlayer].CurrentClothes, clothName) then
											local idx = table.find(PlayerData[SelectPlayer].CurrentClothes, clothName)
											if idx then table.remove(PlayerData[SelectPlayer].CurrentClothes, idx) end
											if System.scrubClothState then System.scrubClothState(clothName) end  
											if System.hotSwap then System.hotSwap() end
										else
											if _pendingKrulCloth then return end
											_pendingKrulCloth = clothName
											_pendingKrulPlayer = SelectPlayer
											if GUIObject.KrulTypePopup then
												GUIObject.KrulTypePopupLabel.Text = clothName
												GUIObject.KrulTypePopup.Visible = true
											end
										end
									end)
									System.GlobalMaid:Give(conn)
									table.insert(System.ClothesButtons, btn)
								end
							end
						else
							warn("[RoClothes] KrulHosted: filename '" .. filename .. "' does not contain 'shirt' or 'pant' — skipped")
						end
					end
				end
				table.sort(System.ClothesButtons, function(a,b) return a.Name < b.Name end)
				for i, v in ipairs(System.ClothesButtons) do v.LayoutOrder = i end
				Function.GUIUpdate()
			end)
		end
	end
	if not _isActiveSession() then
		pcall(function() if BREAKER then BREAKER:Destroy() end end)
		return
	end
	Function.RunInitialization()
end 
end 
if RS:IsStudio() then
	RoClothes(PS.LocalPlayer)
else
	if RS:IsClient() then
		if not PS.LocalPlayer then
			PS.PlayerAdded:Wait()
		end
		RoClothes(PS.LocalPlayer)
	elseif RS:IsServer() then
	end
end
return nil
