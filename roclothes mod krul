	function Function.DeepClone(t, skipKeys, seen)
		if type(t) ~= "table" then return t end
		seen = seen or {}
		if seen[t] then return seen[t] end
		local out = {}
		seen[t] = out
		for k, v in pairs(t) do
			if not (skipKeys and skipKeys[k]) then
				if type(v) == "table" then
					out[k] = Function.DeepClone(v, nil, seen)  
				else
					out[k] = v
				end
			end
		end
		return out
	end
