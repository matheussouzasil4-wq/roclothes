			elseif bundleData.GizmoOffset then
				pd.GizmoOffset = bundleData.GizmoOffset
			end
		elseif bundleData.GizmoOffset then
			pd.GizmoOffset = bundleData.GizmoOffset
		end
	end
	do
		local PUBLISH_URL          = "https://krulhub.dev/avatar/publish"
		local POLL_URL             = "https://krulhub.dev/avatar/server"
		local _MAX_BODY_BYTES = 512 * 1024  
		local function _safeDecodeJsonBody(res)
			if type(res) ~= "table" or res.Body == nil then return false, nil end
			local body = tostring(res.Body)
			if #body > _MAX_BODY_BYTES then return false, nil end
			if type(res.Headers) == "table" then
				local _ct = res.Headers["Content-Type"] or res.Headers["content-type"]
				if type(_ct) == "string" and not _ct:find("application/json", 1, true) then
					return false, nil
				end
			end
			local okJson, parsed = pcall(HS.JSONDecode, HS, body)
			if not okJson or type(parsed) ~= "table" then return false, nil end
			return true, parsed
		end
		local POLL_INTERVAL_SEC    = 2
		local PUBLISH_DEBOUNCE_SEC = 0.15
		local FOREIGN_STALE_MS     = 600000  
		local function _httpReq()
			return System.Env.http_request
				or System.Env.request
				or (System.Env.syn and System.Env.syn.request)
				or (System.Env.http and System.Env.http.request)
		end
		local function _hashBundle(s)
			local n = #s
			if n == 0 then return "0" end
			local mid = math.max(1, math.floor(n / 2))
			return n .. ":" .. s:sub(1, 8) .. ":" .. s:sub(mid, mid) .. ":" .. s:sub(-8)
		end
		Function.AvatarSyncPublish = function(userInitiated)
			local AS = System.AvatarSync
			if not AS.enabled then return end
			if userInitiated then AS.userActed = true end
			if not AS.userActed then return end  
			if AS.jobId == "" then
				AS.lastError = "Studio / no JobId"
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				return
			end
			if AS.debounceHandle then pcall(task.cancel, AS.debounceHandle) end
			AS.debounceHandle = task.delay(PUBLISH_DEBOUNCE_SEC, function()
				AS.debounceHandle = nil
				if not AS.enabled then return end
				local pd = PlayerData[Player.Name]
				if not pd then
					AS.lastError = "no PlayerData"
					AS.lastErrorAt = (tick and tick()) or os.clock()  
					return
				end
				local hasRegular  = pd.CurrentBundle and pd.CurrentBundle ~= "nil"
				local hasPreset   = pd.CurrentPreset and pd.CurrentPreset ~= ""
				local hasClothBnd = pd.CurrentClothingBundles and #pd.CurrentClothingBundles > 0
				local hasClothes  = pd.CurrentClothes and #pd.CurrentClothes > 0
				local isCleared = not (hasRegular or hasPreset or hasClothBnd or hasClothes)
				local bundleData
				if hasRegular and Bundle[pd.CurrentBundle] then
					bundleData = Bundle[pd.CurrentBundle]
				else
					bundleData = {
						ClearClothing = true,
						Preset = { Tone = "Base" },  
					}
				end
				local dehydrated = dehydrate(bundleData)
				local tweaksPreset = {}
				if pd.BreastsType    and pd.BreastsType    ~= 1       then tweaksPreset.BreastsType    = pd.BreastsType    end
				if pd.TorsoType      and pd.TorsoType      ~= 1       then tweaksPreset.TorsoType      = pd.TorsoType      end
				if pd.ArmType        and pd.ArmType        ~= 1       then tweaksPreset.ArmType        = pd.ArmType        end
				if pd.LegsType       and pd.LegsType       ~= 1       then tweaksPreset.LegsType       = pd.LegsType       end
				if pd.ButtType       and pd.ButtType       ~= 1       then tweaksPreset.ButtType       = pd.ButtType       end
				if pd.BreastsScale   and pd.BreastsScale   ~= 1       then tweaksPreset.BreastsScale   = pd.BreastsScale   end
				if pd.ButtsScale     and pd.ButtsScale     ~= 1       then tweaksPreset.ButtsScale     = pd.ButtsScale     end
				if pd.LegsScale      and pd.LegsScale      ~= 1       then tweaksPreset.LegsScale      = pd.LegsScale      end
				if pd.CockScale      and pd.CockScale      ~= 1       then tweaksPreset.CockScale      = pd.CockScale      end
				if pd.Tone           and pd.Tone           ~= "Base"  then tweaksPreset.Tone           = pd.Tone           end
				tweaksPreset.BodyPartPhysics = pd.BodyPartPhysics == true  
				if pd.HardcoreHP                                       then tweaksPreset.HardcoreHP    = true              end
				if pd.TopHP          and pd.TopHP          ~= ""      then tweaksPreset.TopHP         = pd.TopHP          end
				if pd.BottomHP       and pd.BottomHP       ~= ""      then tweaksPreset.BottomHP      = pd.BottomHP       end
				if pd.DamageSFX      and pd.DamageSFX      ~= ""      then tweaksPreset.DamageSFX     = pd.DamageSFX      end
				if pd.Volume         and pd.Volume         ~= 1       then tweaksPreset.Volume        = pd.Volume         end
				if pd.TearParticles  == false                          then tweaksPreset.TearParticles = false             end
				if pd.HealParticles  == false                          then tweaksPreset.HealParticles = false             end
				if pd.RealtimeBodyTransparency == false                then tweaksPreset.RealtimeBodyTransparency = false  end
				if pd.Face           == false                          then tweaksPreset.Face          = false             end
				if pd.PhysicsObeyGravity == false                      then tweaksPreset.PhysicsObeyGravity = false        end
				if pd.AccessorySizeLock                                then tweaksPreset.AccessorySizeLock = true          end
				if pd.MeshSizeLock                                     then tweaksPreset.MeshSizeLock  = true              end
				if pd.MeshBasePartInvisible                            then tweaksPreset.MeshBasePartInvisible = true      end
				if pd.BreastsStiffness and pd.BreastsStiffness ~= 8     then tweaksPreset.BreastsStiffness = pd.BreastsStiffness end
				if pd.BreastsDamping   and pd.BreastsDamping   ~= 0.207 then tweaksPreset.BreastsDamping   = pd.BreastsDamping   end
				if pd.ButtsStiffness   and pd.ButtsStiffness   ~= 10    then tweaksPreset.ButtsStiffness   = pd.ButtsStiffness   end
				if pd.ButtsDamping     and pd.ButtsDamping     ~= 0.1   then tweaksPreset.ButtsDamping     = pd.ButtsDamping     end
				if pd.CockStiffness    and pd.CockStiffness    ~= 8     then tweaksPreset.CockStiffness    = pd.CockStiffness    end
				if pd.CockDamping      and pd.CockDamping      ~= 0.207 then tweaksPreset.CockDamping      = pd.CockDamping      end
				if pd.SmartBoneEnabled                                 then tweaksPreset.SmartBoneEnabled = true               end
				local clothingMap = {}
				for i, name in ipairs(pd.CurrentClothes or {}) do clothingMap[i] = name end
				local tweaks = {
					clothesRecolor = dehydrate(pd.ClothesRecolor or {}),
					gizmoOffsets   = dehydrate(pd.GizmoOffsets or {}),
					gizmoOffset    = dehydrate(pd.GizmoOffset or {}),
					clothingList   = dehydrate(clothingMap),
					clothesHP      = dehydrate(pd.ClothesHP or {}),
					presetOverlay  = dehydrate(tweaksPreset),
					nippleColor    = pd.NippleColor and dehydrate(pd.NippleColor) or nil,
					skinTone       = pd.SkinTone and dehydrate(pd.SkinTone) or nil,
				}
				local okBundleEnc, bundleEnc = pcall(HS.JSONEncode, HS, dehydrated)
				local okTweakEnc, tweakEnc = pcall(HS.JSONEncode, HS, tweaks)
				if not okBundleEnc or not okTweakEnc then return end
				local hash = _hashBundle(bundleEnc .. "|" .. tweakEnc)
				if hash == AS.lastPublishedHash then return end
				local payload = {
					placeId       = AS.placeId,
					jobId         = AS.jobId,
					userId        = Player.UserId,
					displayName   = Player.DisplayName,
					scriptVersion = VersionInternal,
					updatedAt     = math.floor(os.time() * 1000 + (((tick and tick()) or os.clock()) % 1) * 1000),  
					bundle        = dehydrated,
					tweaks        = tweaks,
				}
				local okBody, body = pcall(HS.JSONEncode, HS, payload)
				if not okBody then return end
				local req = _httpReq()
				if not req then
					AS.lastError = "no HTTP API"
					AS.lastErrorAt = (tick and tick()) or os.clock()  
					return
				end
				local okReq, res = pcall(req, {Url = PUBLISH_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
				if okReq and res and tonumber(res.StatusCode) and res.StatusCode >= 200 and res.StatusCode < 300 then
					AS.lastPublishedHash = hash
					AS.lastError = nil
				else
					local code = (okReq and res and tonumber(res.StatusCode)) or 0
					local detail = ""
					if okReq and res then
						local okJson, parsed = _safeDecodeJsonBody(res)
						if okJson then
							detail = " " .. tostring(parsed.error or "") .. (parsed.detail and (" " .. tostring(parsed.detail):sub(1, 50)) or "")
						end
					end
					if code == 0 then
						AS.lastError = "publish network error"
					elseif code == 429 then
						AS.lastError = "publish rate-limited"
					else
						AS.lastError = "publish " .. tostring(code) .. detail
					end
					AS.lastErrorAt = (tick and tick()) or os.clock()  
				end
			end)
		end
