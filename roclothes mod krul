		local function _writeImportedBundleToDisk(name, input)
			if not env.writefile then return end
			local t = {}
			local function transferTable(n, isTable)
				local newTable = {}
				for i, v in pairs(n) do
					if isTable then
						if typeof(v) == "table" then newTable[i] = transferTable(v, true)
						else newTable[i] = v end
					else
						if typeof(v) == "table" then t[i] = transferTable(v, true)
						else t[i] = v end
					end
				end
				return newTable
			end
			transferTable(input)
			local function convertTable(inp)
				for i, v in pairs(inp) do
					if typeof(v) == "table" then convertTable(v)
					else inp[i] = Function.convertToJSON(v) end
				end
			end
			convertTable(t)
			t["BundleName"] = name
			pcall(env.writefile, "RClothesLerp/Bundles/" .. _sanitizeBundleName(name) .. ".json", HS:JSONEncode(t))
		end
		local function _submitImportedBundleToCommunity(name, input)
			local SUBMIT_URL = "https://krulhub.dev/roclothes/submit"
			local lp = PS.LocalPlayer
			local payload = {
				name           = name,
				bundle         = dehydrate(input),
				scriptVersion  = VersionInternal,
				manifestVersion = System.ManifestVersion or "unknown",
				submitter = {
					userId      = lp and lp.UserId or 0,
					displayName = lp and lp.DisplayName or "Unknown",
				},
			}
			local okEnc, body = pcall(HS.JSONEncode, HS, payload)
			if not okEnc then
				warn("[RoClothes] Submit encode failed for '" .. name .. "': " .. tostring(body))
				return false
			end
			local reqFunc = env.http_request or (syn and syn.request) or (http and http.request)
			if not reqFunc then
				warn("[RoClothes] Submit failed for '" .. name .. "': no http_request API on this executor")
				return false
			end
			local ok, res = pcall(reqFunc, {
				Url = SUBMIT_URL, Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = body,
			})
			if ok and res and tonumber(res.StatusCode) and res.StatusCode >= 200 and res.StatusCode < 300 then
				return true
			end
			warn("[RoClothes] Submit failed for '" .. name .. "': " .. tostring(res and res.StatusCode or res))
			return false
		end
