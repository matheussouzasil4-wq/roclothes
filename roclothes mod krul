		local function _overlayTweaks(name, tweaks)
			local pd = PlayerData[name]
			if not pd or type(tweaks) ~= "table" then return end
			if type(tweaks.clothesRecolor) == "table" then
				for cloth, colors in pairs(tweaks.clothesRecolor) do
				do local _safe = _sanitizeClothesRecolor(colors); if _safe then pd.ClothesRecolor[cloth] = _safe end end 
				end
			end
			local function _isFiniteNum(x)
				return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
			end
			if type(tweaks.gizmoOffsets) == "table" then
				pd.GizmoOffsets = _sanitizeGizmoOffsets(tweaks.gizmoOffsets)
				local _relinked = false
				if pd.GizmoTarget and pd.GizmoOffsets[pd.GizmoTarget] then
					pd.GizmoOffset = pd.GizmoOffsets[pd.GizmoTarget]
					_relinked = true
				end
				if not _relinked and type(tweaks.gizmoOffset) == "table" then
					pd.GizmoOffset = tweaks.gizmoOffset
				end
			elseif type(tweaks.gizmoOffset) == "table" then
				pd.GizmoOffset = tweaks.gizmoOffset
			end
			if type(tweaks.clothingList) == "table" then
				local newClothing = {}
				local _seen = {}  
				for _, n in pairs(tweaks.clothingList) do
					if type(n) == "string" and #n <= 128 and not _seen[n] and #newClothing < 256 then
						_seen[n] = true
						table.insert(newClothing, n)
					end
				end
				pd.CurrentClothes = newClothing
			end
			if type(tweaks.clothesHP) == "table" then
				local _safe = {}
				for cloth, entry in pairs(tweaks.clothesHP) do
					if type(cloth) == "string" and #cloth <= 128 and type(entry) == "table" then
						local _hp = entry.HP
						if (_hp == "TopHP" or _hp == "BottomHP") and type(entry.Inverse) == "boolean" then
							_safe[cloth] = {HP = _hp, Inverse = entry.Inverse}
						end
					end
				end
				pd.ClothesHP = _safe
			end
			if type(tweaks.presetOverlay) == "table" then
				for k, v in pairs(tweaks.presetOverlay) do
					if _PEER_ALLOWED_PRESET_KEYS[k] then
						local _ok = true
						if type(v) == "number" then
							_ok = _isFiniteNum(v)
							if _ok and (k:find("Scale$") or k:find("Stiffness$") or k:find("Damping$") or k == "Volume") then
								_ok = v >= 0 and v <= 10
							end
						end
						if _ok then pd[k] = v end
					end
				end
			end
			if tweaks.nippleColor ~= nil then pd.NippleColor = tweaks.nippleColor end
			if tweaks.skinTone    ~= nil then pd.SkinTone    = tweaks.skinTone    end
		end
		local function _runExecuteForPeer(foreign, dataKey, bundleData, tweaks)
			local _stillLive = function() return foreign and foreign.Parent == PS end
			if not _stillLive() then return false, "peer left before apply" end
			local _safeBundle = bundleData
			pcall(function()
				local _enc = HS:JSONEncode(bundleData)
				_safeBundle = HS:JSONDecode(_enc)
			end)
			Bundle[dataKey] = _safeBundle
			Function.PlayerDataAdd(foreign.Name)
			if not _stillLive() then return false, "peer left during PlayerDataAdd" end
			local pd = PlayerData[foreign.Name]
			if not pd then return false, "PlayerData add failed" end
			pd.CurrentBundle           = dataKey
			pd.CurrentPreset           = nil
			pd.CurrentClothingBundles  = {}
			Function.ApplyBundleToPeerData(foreign.Name, _safeBundle)
			if not _stillLive() then return false, "peer left during ApplyBundleToPeerData" end
			_overlayTweaks(foreign.Name, tweaks)
			pd.LastRequestID = (pd.LastRequestID or 0) + 1
			local rid = pd.LastRequestID
			pcall(Function.CharacterReset, foreign.Name)
			if not _stillLive() then return false, "peer left during CharacterReset" end
			return pcall(Function.CharacterExecute, foreign.Character, foreign.Name, nil, rid)
		end
		local function _syncApplyToPeer(userId, bundleData, updatedAt, tweaks)
			local AS = System.AvatarSync
			if userId == Player.UserId then return end
			local foreign = PS:GetPlayerByUserId(userId)
			if not foreign then
				AS.lastError = "peer " .. tostring(userId) .. " left?"
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				return
			end
			if SelectPlayer == foreign.Name then
				if AS.syncedPeers[userId] then
					local prev = AS.syncedPeers[userId]
					if prev.characterAddedConn then
						pcall(function() prev.characterAddedConn:Disconnect() end)
					end
					AS.syncedPeers[userId] = nil
				end
				return
			end
			local existing = AS.syncedPeers[userId]
			if existing and existing.lastUpdatedMs == updatedAt and existing.applied then
				return  
			end
			local dataKey = "_peer_" .. foreign.Name
			if not foreign.Character then
				if not existing or existing.lastUpdatedMs ~= updatedAt then
					if existing and existing.characterAddedConn then
						pcall(function() existing.characterAddedConn:Disconnect() end)
					end
					local entry = {
						dataKey       = dataKey,
						playerName    = foreign.Name,
						lastUpdatedMs = updatedAt,
						bundleData    = bundleData,
						tweaks        = tweaks,
						applied       = false,
					}
					entry.characterAddedConn = foreign.CharacterAdded:Connect(function()
						task.wait(0.2)
						if not _isActiveSession() then return end
						local e = AS.syncedPeers[userId]
						if not e then return end
						if SelectPlayer == foreign.Name then return end  
						local ok, err = _runExecuteForPeer(foreign, e.dataKey, e.bundleData, e.tweaks)
						if ok then e.applied = true else
							AS.lastError = "respawn " .. tostring(foreign.Name):sub(1,16) .. ": " .. tostring(err):sub(1,30)
							AS.lastErrorAt = (tick and tick()) or os.clock()  
						end
					end)
					AS.syncedPeers[userId] = entry
				end
				return
			end
			local ok, err = _runExecuteForPeer(foreign, dataKey, bundleData, tweaks)
			if not ok then
				AS.lastError = "apply " .. tostring(foreign.Name):sub(1, 16) .. ": " .. tostring(err):sub(1, 30)
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				warn("[RoClothes] AvatarSync apply failed for " .. foreign.Name .. ": " .. tostring(err))
				return
			end
			local conn = existing and existing.characterAddedConn
			if not conn then
				conn = foreign.CharacterAdded:Connect(function()
					task.wait(0.2)
					if not _isActiveSession() then return end
					local e = AS.syncedPeers[userId]
					if not e or not e.bundleData then return end
					if SelectPlayer == foreign.Name then return end  
					local rok, rerr = _runExecuteForPeer(foreign, e.dataKey, e.bundleData, e.tweaks)
					if not rok then
						AS.lastError = "respawn " .. tostring(foreign.Name):sub(1,16) .. ": " .. tostring(rerr):sub(1,30)
						AS.lastErrorAt = (tick and tick()) or os.clock()  
					end
				end)
			end
			AS.syncedPeers[userId] = {
				dataKey            = dataKey,
				playerName         = foreign.Name,
				lastUpdatedMs      = updatedAt,
				bundleData         = bundleData,
				tweaks             = tweaks,
				characterAddedConn = conn,
				applied            = true,
			}
		end
		local function _syncRemovePeer(userId)
			local AS = System.AvatarSync
			local entry = AS.syncedPeers[userId]
			if not entry then return end
			if entry.playerName == SelectPlayer then
				return  
			end
			if entry.characterAddedConn then
				pcall(function() entry.characterAddedConn:Disconnect() end)
			end
			if PlayerData[entry.playerName] then
				PlayerData[entry.playerName].LastRequestID = (PlayerData[entry.playerName].LastRequestID or 0) + 1
				pcall(Function.CharacterReset, entry.playerName)
				if PlayerData[entry.playerName].ExecutionMaid then
					pcall(function() PlayerData[entry.playerName].ExecutionMaid:DoCleaning() end)
				end
				PlayerData[entry.playerName] = nil
			end
			Bundle[entry.dataKey] = nil
			if Method2CharacterFolder then
				local m = Method2CharacterFolder:FindFirstChild(entry.playerName)
				if m then pcall(function() m:Destroy() end) end
			end
			AS.syncedPeers[userId] = nil
		end
		Function.AvatarSyncPoll = function()
			local AS = System.AvatarSync
			if not AS.enabled or AS.jobId == "" then return end
			local req = _httpReq()
			if not req then return end
			local url = POLL_URL .. "?placeId=" .. tostring(AS.placeId)
				.. "&jobId=" .. HS:UrlEncode(AS.jobId)
				.. "&self=" .. tostring(Player.UserId)
			if AS.pollCursor then url = url .. "&since=" .. tostring(AS.pollCursor) end
			local okReq, res = pcall(req, {Url = url, Method = "GET"})
			if not okReq or not res then
				AS.lastError = "poll network error"
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				return
			end
			local code = tonumber(res.StatusCode) or 0
			if code == 304 then AS.lastError = nil; return end
			if code < 200 or code >= 300 then
				AS.lastError = (code == 429) and "poll rate-limited" or ("poll " .. tostring(code))
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				return
			end
			AS.lastError = nil
			local okJson, parsed = _safeDecodeJsonBody(res)
			if not okJson or not parsed.ok then
				AS.lastError = "poll: bad response"
				AS.lastErrorAt = (tick and tick()) or os.clock()  
				return
			end
			AS.lastSeenCount = (type(parsed.entries) == "table") and #parsed.entries or 0
			if type(parsed.entries) == "table" then
				for _, e in ipairs(parsed.entries) do
					if type(e) == "table" and tonumber(e.userId) and type(e.bundle) == "table" then
						local rehydrated = rehydrate(e.bundle)
						local isEmptyBundle = rehydrated.ClearClothing == true or not (
							rehydrated.Clothing or rehydrated.Accessory or rehydrated.Clothes or
							rehydrated.Preset or rehydrated.MeshEdit or rehydrated.Recolor or
							rehydrated.NippleColor or rehydrated["Body Color"] or rehydrated.HPClothes
						)
						local tweaksHaveContent = false
						if type(e.tweaks) == "table" then
							tweaksHaveContent =
								(type(e.tweaks.clothingList)  == "table" and next(e.tweaks.clothingList)  ~= nil) or
								(type(e.tweaks.presetOverlay) == "table" and next(e.tweaks.presetOverlay) ~= nil) or
								(type(e.tweaks.clothesHP)     == "table" and next(e.tweaks.clothesHP)     ~= nil) or
								(type(e.tweaks.clothesRecolor)== "table" and next(e.tweaks.clothesRecolor)~= nil) or
								(e.tweaks.nippleColor ~= nil) or
								(e.tweaks.skinTone ~= nil)
						end
						if isEmptyBundle and not tweaksHaveContent then
							_syncRemovePeer(tonumber(e.userId))
						else
							local tweaks = nil
							if type(e.tweaks) == "table" then
								tweaks = {
									clothesRecolor = type(e.tweaks.clothesRecolor) == "table" and rehydrate(e.tweaks.clothesRecolor) or nil,
									gizmoOffsets   = type(e.tweaks.gizmoOffsets)   == "table" and rehydrate(e.tweaks.gizmoOffsets)   or nil,
									gizmoOffset    = type(e.tweaks.gizmoOffset)    == "table" and rehydrate(e.tweaks.gizmoOffset)    or nil,
									clothingList   = type(e.tweaks.clothingList)   == "table" and rehydrate(e.tweaks.clothingList)   or nil,
									clothesHP      = type(e.tweaks.clothesHP)      == "table" and rehydrate(e.tweaks.clothesHP)      or nil,
									presetOverlay  = type(e.tweaks.presetOverlay)  == "table" and rehydrate(e.tweaks.presetOverlay)  or nil,
									nippleColor    = e.tweaks.nippleColor and rehydrate(e.tweaks.nippleColor) or nil,
									skinTone       = e.tweaks.skinTone and rehydrate(e.tweaks.skinTone) or nil,
								}
							end
							local _aOk, _aErr = pcall(_syncApplyToPeer, tonumber(e.userId), rehydrated, tonumber(e.updatedAt) or 0, tweaks)
							if not _aOk then
								AS.lastError = "applyfn: " .. tostring(_aErr):sub(1, 40)
								AS.lastErrorAt = (tick and tick()) or os.clock()  
							end
						end
					end
				end
			end
			if type(parsed.removed) == "table" then
				for _, uid in ipairs(parsed.removed) do
					local _uid = tonumber(uid)
					if _uid and _uid ~= Player.UserId then _syncRemovePeer(_uid) end
				end
			end
			local nowMs = tonumber(parsed.now) or (os.time() * 1000)
			local _stale = {}
			for uid, entry in pairs(AS.syncedPeers) do
				if nowMs - entry.lastUpdatedMs > FOREIGN_STALE_MS then
					_stale[#_stale+1] = uid
				end
			end
			for _, uid in ipairs(_stale) do _syncRemovePeer(uid) end
			if tonumber(parsed.cursor) then AS.pollCursor = tonumber(parsed.cursor) end
		end
		Function.AvatarSyncStart = function()
			local AS = System.AvatarSync
			if AS.pollHandle then return end
			AS.clearToken = (AS.clearToken or 0) + 1 
			AS.pollHandle = task.spawn(function()
				while AS.enabled do
					pcall(Function.AvatarSyncPoll)
					task.wait(POLL_INTERVAL_SEC)
				end
				AS.pollHandle = nil
			end)
			if not AS.heartbeatHandle then
				AS.heartbeatHandle = task.spawn(function()
					while AS.enabled do
						task.wait(30)  
						if AS.enabled then
							AS.lastPublishedHash = nil  
							pcall(Function.AvatarSyncPublish)
						end
					end
					AS.heartbeatHandle = nil
				end)
			end
		end
		local _playerRemovingConn = PS.PlayerRemoving:Connect(function(player)
			if System.AvatarSync.enabled then
				_syncRemovePeer(player.UserId)
			end
			pcall(function()
				local _pd = PlayerData[player.Name]
				if _pd then
					if _pd.ExecutionMaid then pcall(function() _pd.ExecutionMaid:DoCleaning() end) end
					PlayerData[player.Name] = nil
				end
			end)
		end)
		System.GlobalMaid:Give(_playerRemovingConn)
		Function.AvatarSyncStop = function()
			local AS = System.AvatarSync
			if AS.userActed then
				AS.clearToken = (AS.clearToken or 0) + 1
				local _tok = AS.clearToken
				task.spawn(function()
					if AS.clearToken ~= _tok then return end 
					_publishClearedSync()
				end)
			end
			AS.enabled = false
			AS.userActed = false
			if AS.pollHandle then pcall(task.cancel, AS.pollHandle); AS.pollHandle = nil end
			if AS.heartbeatHandle then pcall(task.cancel, AS.heartbeatHandle); AS.heartbeatHandle = nil end
			if AS.debounceHandle then pcall(task.cancel, AS.debounceHandle); AS.debounceHandle = nil end
			local _peers = {}
			for uid in pairs(AS.syncedPeers) do _peers[#_peers+1] = uid end
			for _, uid in ipairs(_peers) do _syncRemovePeer(uid) end
			AS.lastPublishedHash = nil
			AS.pollCursor = nil
		end
	end
	function Function.StringTo(String, Type)
		local Split = string.split(String, ",")
		if Type == "CFrame" then
			return CFrame.new(
				tonumber(Split[1]),  tonumber(Split[2]),  tonumber(Split[3]),
				tonumber(Split[4]),  tonumber(Split[5]),  tonumber(Split[6]),
				tonumber(Split[7]),  tonumber(Split[8]),  tonumber(Split[9]),
				tonumber(Split[10]), tonumber(Split[11]), tonumber(Split[12])
			)
		elseif Type == "RGB" then
			return Color3.fromRGB(tonumber(Split[1]),tonumber(Split[2]),tonumber(Split[3]))
		elseif Type == "Vector3" then
			return Vector3.new(tonumber(Split[1]),tonumber(Split[2]),tonumber(Split[3]))
		end
	end
