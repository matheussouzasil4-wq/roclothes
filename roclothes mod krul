		local function fetchAndSaveChunks(chunks, cacheFile, manifestRaw)
			local results = table.create(#chunks)
			local pending = #chunks
			for i, chunk in ipairs(chunks) do
				local idx = i
				local url = (string.find(chunk, "://", 1, true)) and chunk or (BASE_URL .. chunk)
				task.spawn(function()
					results[idx] = fetchJson(url, 2)
					pending -= 1
				end)
			end
			repeat task.wait(0.05) until pending == 0
			local merged = {}
			for i = 1, #chunks do
				if not results[i] then return nil end
				deepMerge(merged, results[i])
			end
			if env.writefile then
				local okE, encoded = pcall(HttpService.JSONEncode, HttpService, merged)
				if okE and type(encoded) == "string" then
					pcall(env.writefile, cacheFile, encoded)
				end
				if manifestRaw then pcall(env.writefile, MANIFEST_CACHE, manifestRaw) end
			end
