	local _gcaMemo = {}
	local _gcaMemoCount = 0
	function Function.GetAsset(Path)
		if not Path or Path == "" then return Path end
		local cached = _gcaMemo[Path]
		if cached ~= nil then return cached end
		if _gcaMemoCount >= _GCA_MEMO_MAX then
			_gcaMemo = {}
			_gcaMemoCount = 0
		end
		local RelativePath = (Path:gsub("rbxasset://", ""))
		local gca = getcustomasset or getsynasset
		if System.isfile and gca then
			if System.isfile(RelativePath) then
				local ok, url = pcall(gca, RelativePath)
				if ok and type(url) == "string" and #url > 0 then
					_gcaMemo[Path] = url; _gcaMemoCount = _gcaMemoCount + 1
					return url
				end
			end
			if RelativePath:sub(1, 16) ~= "RClothesContent/" then
				local prefixed = "RClothesContent/" .. RelativePath
				if System.isfile(prefixed) then
					local ok, url = pcall(gca, prefixed)
					if ok and type(url) == "string" and #url > 0 then
						_gcaMemo[Path] = url; _gcaMemoCount = _gcaMemoCount + 1
						return url
					end
				end
			end
		end
		_gcaMemo[Path] = Path; _gcaMemoCount = _gcaMemoCount + 1
		return Path
	end
	local _mpCache       = {}      
	local _mpCacheOrder  = {}      
	function Function.CachedCreateMeshPartAsync(meshId, collisionFidelity, renderFidelity)
		collisionFidelity = collisionFidelity or Enum.CollisionFidelity.Box
		renderFidelity    = renderFidelity    or Enum.RenderFidelity.Performance
		if type(meshId) ~= "string" or meshId == "" then return nil end
		local key = meshId .. "|" .. tostring(collisionFidelity.Value) .. "|" .. tostring(renderFidelity.Value)
		local cached = _mpCache[key]
		if cached and cached.Parent then
			return cached:Clone()
		end
		local _IS = game:GetService("InsertService")
		local ok, mp = pcall(_IS.CreateMeshPartAsync, _IS, meshId, collisionFidelity, renderFidelity)
		if not ok or not mp then return nil end
		local _RS = game:GetService("ReplicatedStorage")
		local holder = _RS:FindFirstChild("_RCMpCache")
		if not holder then
			holder = Instance.new("Folder")
			holder.Name = "_RCMpCache"
			holder.Parent = _RS
		end
		mp.Name = "tpl_" .. (mp.Name or "MeshPart")
		mp.Parent = holder
		_mpCache[key] = mp
		table.insert(_mpCacheOrder, key)
		while #_mpCacheOrder > _MP_CACHE_MAX do
			local oldKey = table.remove(_mpCacheOrder, 1)
			local old = _mpCache[oldKey]
			if old then pcall(function() old:Destroy() end) end
			_mpCache[oldKey] = nil
		end
		return mp:Clone()
	end
