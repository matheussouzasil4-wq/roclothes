						if env.copy then env.copy(exportString) else error("no copy") end
					end)
					GUIObject.exportButton.Text = copyOk and "Copied to clipboard!" or "Printed to console"
					if not copyOk then print(exportString) end
					_exportResetToken += 1; local _tok = _exportResetToken
					task.delay(2, function() if _exportResetToken == _tok then GUIObject.exportButton.Text = "Export Bundle" end end)
				end)
			elseif DetectingBundle == "export" then
				DetectingBundle = false
				GUIObject.Bundles.Visible = false
				GUIObject.optionsFrame.Visible = true
				task.spawn(function()
					local SUBMIT_URL = "https://krulhub.dev/roclothes/submit"
					GUIObject.exportButton.Text = "Submitting..."
					local lp = PS.LocalPlayer
					local payload = {
						name           = BButton.Name,
						bundle         = dehydrate(_captureLiveScalesToBundle(bundleData) or bundleData),
						scriptVersion  = VersionInternal,
						manifestVersion = System.ManifestVersion or "unknown",
						submitter = {
							userId      = lp and lp.UserId or 0,
							displayName = lp and lp.DisplayName or "Unknown",
						},
					}
					local okEnc, body = pcall(HS.JSONEncode, HS, payload)
					if not okEnc then
						GUIObject.exportButton.Text = "Encode failed"
						warn("[RoClothes] Submit encode failed: " .. tostring(body))
						_exportResetToken += 1; local _tok = _exportResetToken; task.delay(2, function() if _exportResetToken == _tok then GUIObject.exportButton.Text = "Export Bundle" end end)
						return
					end
					local reqFunc = env.http_request or (syn and syn.request) or (http and http.request)
					local posted = false
					if reqFunc then
						local lastRes
						for attempt = 1, 2 do
							local ok, res = pcall(reqFunc, {
								Url = SUBMIT_URL,
								Method = "POST",
								Headers = {["Content-Type"] = "application/json"},
								Body = body,
							})
							lastRes = res
							if ok and res and tonumber(res.StatusCode) and res.StatusCode >= 200 and res.StatusCode < 300 then
								GUIObject.exportButton.Text = "Submitted for review!"
								posted = true
								break
							end
							if ok and res and res.StatusCode then
								local label = "Submit failed: " .. tostring(res.StatusCode)
								if res.StatusCode == 429 then
									local secs
									local okJ, parsed = pcall(HS.JSONDecode, HS, tostring(res.Body or ""))
									if okJ and type(parsed) == "table" and tonumber(parsed.retryAfterSec) then
										secs = math.floor(tonumber(parsed.retryAfterSec))
									end
									if not secs and res.Headers then
										local hdr = res.Headers["Retry-After"] or res.Headers["retry-after"]
										if tonumber(hdr) then secs = math.floor(tonumber(hdr)) end
									end
									if secs and secs > 0 then
										local hint
										if secs < 60 then
											hint = secs .. "s"
										elseif secs < 3600 then
											hint = math.ceil(secs / 60) .. "m"
										else
											hint = math.ceil(secs / 3600) .. "h"
										end
										label = "Rate-limited — try again in ~" .. hint
									end
								end
								GUIObject.exportButton.Text = label
								warn("[RoClothes] Submit non-2xx: " .. tostring(res.StatusCode) .. " body=" .. tostring(res.Body))
								break
							end
							if attempt == 1 then
								GUIObject.exportButton.Text = "Submit failed — retrying..."
								task.wait(1)
							end
						end
						if not posted and not (lastRes and lastRes.StatusCode) then
							GUIObject.exportButton.Text = "Submit failed (network)"
							warn("[RoClothes] Submit POST transport error after retry: " .. tostring(lastRes))
						end
					else
						GUIObject.exportButton.Text = "No HTTP — copied to clipboard"
					end
					if not posted then
						local exportString = toBundleFormat(_captureLiveScalesToBundle(bundleData) or bundleData, BButton.Name)
						local copyOk = pcall(function()
							if env.copy then env.copy(exportString) else error("no copy") end
						end)
						if not copyOk then
							print(exportString)
						end
					end
					_exportResetToken += 1; local _tok = _exportResetToken; task.delay(2, function() if _exportResetToken == _tok then GUIObject.exportButton.Text = "Export Bundle" end end)
				end)
			elseif DetectingBundle == "delete" then
				local _bDef = Bundle[BButton.Name]
