			local function _cb_thumbUri(item)
				local kind = (item.itemType == "Bundle") and "Outfit" or "Asset"
				return string.format("rbxthumb://type=%s&id=%d&w=150&h=150", kind, item.id)
			end
			local function _cb_isEquipped(item, pd)
				if not pd then return false end
				if not item or not item.id then return false end
				if item.itemType == "Bundle" then
					return tostring(pd.CatalogOutfitId or "") == tostring(item.id)
				end
				local atyp = item.assetType
				local idNum = tonumber(item.id)
				if not idNum then return false end
				if atyp == 11 then
					return tonumber(pd.CatalogClothes and pd.CatalogClothes.Shirt) == idNum
				elseif atyp == 12 then
					return tonumber(pd.CatalogClothes and pd.CatalogClothes.Pants) == idNum
				elseif atyp == 2 then
					return tonumber(pd.CatalogClothes and pd.CatalogClothes.ShirtGraphic) == idNum
				elseif Function.CatalogIsAccessoryAssetType(atyp) then
					if not pd.CatalogAccessory then return false end
					for _, v in ipairs(pd.CatalogAccessory) do
						if tonumber(v) == idNum then return true end
					end
				end
				return false
			end
