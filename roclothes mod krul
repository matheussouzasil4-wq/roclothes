	function Function.SanitizeMeshEditValue(propName, propVal)
		if propVal == nil then return nil, false end
		if propName == "Size" then
			if typeof(propVal) ~= "Vector3" then return nil, false end
			local x, y, z = propVal.X, propVal.Y, propVal.Z
			if x ~= x or y ~= y or z ~= z then return nil, false end
			if math.abs(x) == math.huge or math.abs(y) == math.huge or math.abs(z) == math.huge then return nil, false end
			x = math.clamp(x, 0.05, 256)
			y = math.clamp(y, 0.05, 256)
			z = math.clamp(z, 0.05, 256)
			return Vector3.new(x, y, z), true
		elseif propName == "CFrame" or propName == "CFrame1" then
			if typeof(propVal) ~= "CFrame" then return nil, false end
			local _ok, _components = pcall(propVal.GetComponents, propVal)
			if not _ok or not _components then return nil, false end
			for _, c in ipairs({propVal:GetComponents()}) do
				if c ~= c or math.abs(c) == math.huge then return nil, false end
			end
			return propVal, true
		elseif propName == "MeshId" or propName == "TextureId" then
			if type(propVal) ~= "string" then return nil, false end
			if propVal == "" then return nil, false end
			if propVal:match("^rbxasset://[%w_%-/. ]+$") then return propVal, true end
			if propVal:match("^rbxassetid://%d+$") then return propVal, true end
			return nil, false
		elseif propName == "Transparency" or propName == "Reflectance" then
			if type(propVal) ~= "number" then return nil, false end
			if propVal ~= propVal then return nil, false end  
			return math.clamp(propVal, 0, 1), true
		end
		local _t = type(propVal)
		if _t == "function" or _t == "userdata" or _t == "thread" then return nil, false end
		return propVal, true
	end
