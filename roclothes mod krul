		local function convertTableToString(t,indent)
			indent = indent or 0
			local s = ""
			for i, v in pairs(t) do
				for i = 1, indent do
					s = s .. "	"
				end
				if typeof(v) == "table" then
					if type(i) == "number" then
						s = s ..'['..tostring(i)..'] = { \n'
					else
						s = s ..'["'..tostring(i)..'"] = { \n'
					end
					s = s .. convertTableToString(v,indent+1)
					for i = 1, indent do
						s = s .. "	"
					end
					s = s .. "}, \n"
				else
					if type(i) == "number" then
						s = s ..Function.toFormatString(v)..", \n"
					else
						s = s ..'["'..tostring(i)..'"] = '..Function.toFormatString(v)..", \n"
					end
				end
			end
			return s
		end
		local function toBundleFormat(t,bundleName)
			local s = "[".. Function.toFormatString(bundleName) .."] = { \n"
			s = s .. convertTableToString(t, 1) .. "},"
			return s
		end
		local function _captureLiveScalesToBundle(bdata)
			local pd = PlayerData[SelectPlayer]
			if not pd then return nil end
			local patch = {}
			if pd.BreastsScale  and pd.BreastsScale  ~= 1 then patch.BreastsScale  = pd.BreastsScale  end
			if pd.ButtsScale    and pd.ButtsScale    ~= 1 then patch.ButtsScale    = pd.ButtsScale    end
			if pd.LegsScale     and pd.LegsScale     ~= 1 then patch.LegsScale     = pd.LegsScale     end
			if pd.CockScale     and pd.CockScale     ~= 1 then patch.CockScale     = pd.CockScale     end
			if pd.BreastsType   and pd.BreastsType   ~= 1 then patch.BreastsType   = pd.BreastsType   end
			if pd.ButtType      and pd.ButtType      ~= 1 then patch.ButtType      = pd.ButtType      end
			if pd.TorsoType     and pd.TorsoType     ~= 1 then patch.TorsoType     = pd.TorsoType     end
			if pd.ArmType       and pd.ArmType       ~= 1 then patch.ArmType       = pd.ArmType       end
			if pd.LegsType      and pd.LegsType      ~= 1 then patch.LegsType      = pd.LegsType      end
			if next(patch) == nil then return nil end 
			local out = {}; for k,v in pairs(bdata) do out[k] = v end
			local preset = {}
			if type(bdata.Preset) == "table" then for k,v in pairs(bdata.Preset) do preset[k] = v end end
			for k,v in pairs(patch) do preset[k] = v end
			out.Preset = preset
			return out
		end
