local function _buildPerfMonPanel(GUIObject, RS, globalMaid, getActivePD)
	local FPS_SAMPLES = 30
	local fpsBuf = {}
	local fpsIdx = 0
	local fpsSum = 0  
	local lastRefresh = 0
	globalMaid:Give(RS.Heartbeat:Connect(function(dt)
		fpsIdx = (fpsIdx % FPS_SAMPLES) + 1
		fpsSum = fpsSum - (fpsBuf[fpsIdx] or 0) + dt
		fpsBuf[fpsIdx] = dt
	end))
	globalMaid:Give(RS.Heartbeat:Connect(function()
		local now = os.clock()
		if now - lastRefresh < 0.5 then return end
		lastRefresh = now
		local sum = fpsSum
		local fps = (#fpsBuf > 0 and sum > 0) and math.round(#fpsBuf / sum) or 0
		if fps >= 45 then
			GUIObject.PerfMonFPS.TextColor3 = Color3.fromRGB(100, 255, 100)
		elseif fps >= 25 then
			GUIObject.PerfMonFPS.TextColor3 = Color3.fromRGB(255, 230, 80)
		else
			GUIObject.PerfMonFPS.TextColor3 = Color3.fromRGB(255, 80, 80)
		end
		GUIObject.PerfMonFPS.Text = "FPS: " .. tostring(fps)
		local pData = getActivePD()
		if pData and pData.CurrentPartList then
			local phys = 0
			local _bpp = pData.CurrentPartList.BodyPartPhysics
			if _bpp then for _ in pairs(_bpp) do phys += 1 end end
			GUIObject.PerfMonPhysics.Text = "Physics: " .. phys
			GUIObject.PerfMonPhysics.TextColor3 = phys > 0
				and Color3.fromRGB(255, 180, 100)
				or  Color3.fromRGB(200, 200, 215)
		else
			GUIObject.PerfMonPhysics.Text = "Physics: 0"
		end
		GUIObject.PerfMonMemory.Text = string.format("Mem: %.1f MB", gcinfo() / 1024)
	end))
end
