		local function checkBundle(v, RequestID)
			local _pdSP = PlayerData[SelectPlayer]
			if not _pdSP then return end
			if RequestID and RequestID ~= _pdSP.LastRequestID then return end
			if v.ClearClothing and v.ClearClothing == true then
				PlayerData[SelectPlayer].CurrentClothes = {}
				scrubClothState()
			end
			if v.Preset then
				if type(v.Preset.MeshEdit) == "table" and not v.MeshEdit then
					v.MeshEdit = v.Preset.MeshEdit
				end
				if type(v.Preset.CatalogAssetTypes) == "table" and Function._catalogAssetTypeCache then
					for _idStr, _typeId in pairs(v.Preset.CatalogAssetTypes) do
						if type(_typeId) == "number" and _typeId > 0 and _typeId < 200 and _typeId == math.floor(_typeId) then
							local _k = tonumber(_idStr) or _idStr
							Function._catalogAssetTypeCache[_k] = _typeId
						end
					end
				end
				if v.Preset["CatalogUsername"] or v.Preset["CatalogAccessory"] then
					if GUIObject.Catalog_3:FindFirstChild(SelectPlayer) then
						for i, v in pairs(GUIObject.Catalog_3:FindFirstChild(SelectPlayer):GetChildren()) do
							if not v:IsA("UIGridLayout") and not table.find(PlayerData[SelectPlayer].CatalogAccessory,tonumber(v.Name)) then
								v:Destroy()
							end
						end
					end
				end
				for setting, value in pairs(v.Preset) do
					if setting ~= "PositionPhysicsMultiply"
						and setting ~= "RotationPhysicsMultiply"
						and setting ~= "Method"
						and setting ~= "includedAccessoryNames"
						and setting ~= "excludeAccessoryNames"
						and setting ~= "MeshEdit"  
						and setting ~= "CatalogAssetTypes" then  
						if setting == "CurrentBundle" then
							if Bundle[value] then
								if Bundle[value].ClothingBundle ~= true and Bundle[value].IsPreset ~= true then
									PlayerData[SelectPlayer][setting] = value
								end
								checkBundle(Bundle[value], RequestID)
							else
								warn('[RoClothes] Preset.CurrentBundle references nonexistent bundle "'..tostring(value)..'" — ignored.')
							end
						elseif setting == "CatalogUsername" then
							PlayerData[SelectPlayer][setting] = value
							local _capturedName = SelectPlayer
							local _capturedRID  = RequestID
							task.spawn(function()
								pcall(function()
									local UsernameId = PS:GetUserIdFromNameAsync(value)
									if PlayerData[_capturedName] and _capturedRID and _capturedRID ~= PlayerData[_capturedName].LastRequestID then return end
									local HumanoidDescription = PS:GetHumanoidDescriptionFromUserId(UsernameId)
									if PlayerData[_capturedName] and _capturedRID and _capturedRID ~= PlayerData[_capturedName].LastRequestID then return end
									for i, accessory in pairs(HumanoidDescription:GetAccessories(true)) do
										if PlayerData[_capturedName] and _capturedRID and _capturedRID ~= PlayerData[_capturedName].LastRequestID then return end
										if i > 1 then task.wait(0.05) end
										task.spawn(function()
											if PlayerData[_capturedName] and _capturedRID and _capturedRID ~= PlayerData[_capturedName].LastRequestID then return end
											if accessory and not (v.Preset.CatalogRemove and table.find(v.Preset.CatalogRemove, accessory.AssetId)) then
												local AccessoryInfo = MPS:GetProductInfo(accessory.AssetId)
												local Button = Function.ButtonCreate(AccessoryInfo.Name, GUIObject.Catalog_3:FindFirstChild(_capturedName))
												local AccessoryRemoveButtonConnect
												AccessoryRemoveButtonConnect = Button:FindFirstChildOfClass("TextButton").MouseButton1Click:Connect(function()
													local _pd = PlayerData[_capturedName]
													if not _pd or not _pd.CatalogRemove then return end
													if not table.find(_pd.CatalogRemove, accessory.AssetId) then
														table.insert(_pd.CatalogRemove, accessory.AssetId)
													end
													Button:Destroy()
													local _idx = table.find(AllConnect, AccessoryRemoveButtonConnect)
													if _idx then table.remove(AllConnect, _idx) end
													AccessoryRemoveButtonConnect:Disconnect()
													hotSwap()
												end)
												table.insert(AllConnect, AccessoryRemoveButtonConnect)
											end
										end)
									end
								end)
							end)
						elseif setting == "CatalogAccessory" then
							PlayerData[SelectPlayer][setting] = {}
							for i, x in pairs(value) do
								table.insert(PlayerData[SelectPlayer][setting], tonumber(x) or x)  
								local Button = Function.ButtonCreate(x, GUIObject.Catalog_3:FindFirstChild(SelectPlayer))
