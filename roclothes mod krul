	local _vnsLRU = {
		cache = {},                                                            
		order = {},                                                            
		max   = (UIS and UIS.TouchEnabled and not UIS.KeyboardEnabled) and 4 or 8,
		touch = function(self, modelPath)
			for i, p in ipairs(self.order) do
				if p == modelPath then table.remove(self.order, i); break end
			end
			table.insert(self.order, modelPath)
		end,
		evict = function(self)
			while #self.order > self.max do
				local lru = table.remove(self.order, 1)
				local cached = self.cache[lru]
				self.cache[lru] = nil
				if cached and cached.Parent then pcall(function() cached:Destroy() end) end
			end
		end,
	}
	local function _getVnsModel(modelPath)
		local cached = _vnsLRU.cache[modelPath]
		if cached and cached.Parent then _vnsLRU:touch(modelPath); return cached end
		local objects
		local _gca = getcustomasset or getsynasset
		if _gca and System.isfile and System.isfile(modelPath) then
			local okU, customUrl = pcall(_gca, modelPath)
			if okU and type(customUrl) == "string" and #customUrl > 0 then
				pcall(function() objects = game:GetObjects(customUrl) end)
			end
		end
		if not objects or #objects == 0 then
			pcall(function() objects = game:GetObjects("rbxasset://" .. modelPath) end)
		end
		if not objects or #objects == 0 then return nil end
		local root
		if #objects > 1 then
			root = Instance.new("Folder")
			root.Name = "_VNS_MultiRoot"
			for _, _o in ipairs(objects) do _o.Parent = root end
		else
			root = objects[1]
		end
		local RS = game:GetService("ReplicatedStorage")
		local holder = RS:FindFirstChild("_RCVnsModelCache") or Instance.new("Folder")
		holder.Name = "_RCVnsModelCache"
		holder.Parent = RS
		root.Parent = holder
		_vnsLRU.cache[modelPath] = root
		_vnsLRU:touch(modelPath)   
		_vnsLRU:evict()            
		return root
	end
