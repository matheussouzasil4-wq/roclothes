					pd.AccessoryHP[accName] = hpType
				end
			end
		end
		if bundleData.GizmoOffsets then
			pd.GizmoOffsets = _sanitizeGizmoOffsets(bundleData.GizmoOffsets)
			if pd.GizmoTarget and pd.GizmoOffsets[pd.GizmoTarget] then
