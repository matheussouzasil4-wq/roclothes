		local function rebuildGimbal()
			if not PlayerData[SelectPlayer] then destroyGimbal(); return end
			local data = PlayerData[SelectPlayer]
			if not data.GizmoTarget then destroyGimbal(); return end
			if Gimbal.adornPart and Gimbal.adornPart.Parent and data.GizmoTarget == Gimbal.cachedTarget then
				local go0 = data.GizmoOffset or {}
				local rot_cf = go0.RotCF or CFrame.new()
				local bf = Gimbal.adornPart.CFrame * rot_cf:Inverse()
				local center = Gimbal.adornPart.Position
				for _, h in ipairs(Gimbal.handles) do
					local hd = Gimbal.handleData[h]
					if hd and hd.localDir then
						if hd.isShaft then
							local wd   = bf:VectorToWorldSpace(hd.localDir)
							local up   = Vector3.new(0,1,0)
							local rVec = math.abs(wd:Dot(up)) < 0.99 and wd:Cross(up).Unit or Vector3.new(1,0,0)
							local bVec = rVec:Cross(wd)
							h.CFrame = CFrame.fromMatrix(center + bf:VectorToWorldSpace(hd.localDir * hd.halfLen), rVec, wd, bVec)
						else
							h.CFrame = CFrame.new(center + bf:VectorToWorldSpace(hd.localDir * hd.tipLen))
						end
					end
				end
				return
			end
			local part = nil
			if data.GizmoTarget and data.GizmoTarget:sub(1, 4) == "acc:" then
				local accName = data.GizmoTarget:sub(5)
				local char = PS:FindFirstChild(SelectPlayer) and PS:FindFirstChild(SelectPlayer).Character
				if char then
					local acc = char:FindFirstChild(accName)
					if acc and acc:IsA("Accessory") then
						part = acc:FindFirstChild("Handle")
					end
				end
			else
				local meshMap = data.CurrentPartList
					and data.CurrentPartList.RealtimeUpdateList
					and data.CurrentPartList.RealtimeUpdateList.Mesh
				if meshMap then
					for p in pairs(meshMap) do
						if p and p.Name == data.GizmoTarget then part = p; break end
					end
				end
			end
			if not part or not part.Parent then destroyGimbal(); return end
			if Gimbal.adornPart == part then return end
			destroyGimbal()
			Gimbal.adornPart = part
			Gimbal.cachedTarget = data.GizmoTarget
			local bf_ring
			do
				local go0 = PlayerData[SelectPlayer] and PlayerData[SelectPlayer].GizmoOffset or {}
				bf_ring = part.CFrame * (go0.RotCF or CFrame.new()):Inverse()
			end
			local selBox = Instance.new("SelectionBox")
			selBox.Adornee             = part
			selBox.Color3              = Color3.fromRGB(0, 162, 255)
			selBox.LineThickness       = 0.04
			selBox.SurfaceTransparency = 0.85
			selBox.SurfaceColor3       = Color3.fromRGB(0, 162, 255)
			selBox.Parent              = workspace
			Gimbal.selBox               = selBox
			if not Gimbal.mouse then
				Gimbal.mouse = game:GetService("Players").LocalPlayer:GetMouse()
			end
			local mouse = Gimbal.mouse
			local axisX = Vector3.new(1, 0, 0)  
			local axisY = Vector3.new(0, 1, 0)  
			local axisZ = Vector3.new(0, 0, 1)  
			local function weldToPart(h)
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = part; wc.Part1 = h; wc.Parent = h
			end
			local function makeShaft(localDir, len, color)
				local shaft        = Instance.new("Part")
				shaft.Name         = "GimbalShaft"
				shaft.Size         = Vector3.new(0.07, len * 0.82, 0.07)
				shaft.Color        = color
				shaft.Material     = Enum.Material.SmoothPlastic
				shaft.Transparency = 0.3
				shaft.CanCollide   = false
				shaft.CanQuery     = false
				shaft.CanTouch     = false
				shaft.Anchored     = true
				shaft.CastShadow   = false
				local shaftWorldPos = part.Position + bf_ring:VectorToWorldSpace(localDir * (len * 0.42))
				local wd   = bf_ring:VectorToWorldSpace(localDir)
				local up   = Vector3.new(0, 1, 0)
				local rVec = math.abs(wd:Dot(up)) < 0.99 and wd:Cross(up).Unit or Vector3.new(1,0,0)
				local bVec = rVec:Cross(wd)
				shaft.CFrame   = CFrame.fromMatrix(shaftWorldPos, rVec, wd, bVec)
				shaft.Parent   = workspace
				table.insert(Gimbal.handles, shaft)
				Gimbal.handleData[shaft] = { isShaft = true, localDir = localDir, halfLen = len * 0.42 }
			end
			local function makeTip(localDir, len, color, key, posAxisLocal)
				local tip        = Instance.new("Part")
				tip.Name         = "GimbalTip_" .. key
				tip.Size         = Vector3.new(0.38, 0.38, 0.38)
				tip.Color        = color
				tip.Material     = Enum.Material.SmoothPlastic
				tip.Transparency = 0.15
				tip.CanCollide   = false
				tip.CanQuery     = true
				tip.CanTouch     = false
				tip.Anchored     = true
				tip.CastShadow   = false
				tip.CFrame       = CFrame.new(part.Position + bf_ring:VectorToWorldSpace(localDir * len))
				local m          = Instance.new("SpecialMesh", tip)
				m.MeshType       = Enum.MeshType.Sphere
				tip.Parent       = workspace
				table.insert(Gimbal.handles, tip)
				Gimbal.handleData[tip] = { key = key, isRotate = false, posAxisLocal = posAxisLocal, localDir = localDir, tipLen = len }
				return tip
			end
			local TOFFSET = 2.2                    
			local RED     = Color3.fromRGB(220, 50, 50)
			local GREEN   = Color3.fromRGB(50, 200, 50)
			local BLUE    = Color3.fromRGB(60, 110, 255)
			makeShaft( axisX, TOFFSET, RED)   makeTip( axisX, TOFFSET, RED,   "PosX", axisX)
			makeShaft(-axisX, TOFFSET, RED)   makeTip(-axisX, TOFFSET, RED,   "PosX", axisX)
			makeShaft( axisY, TOFFSET, GREEN) makeTip( axisY, TOFFSET, GREEN, "PosY", axisY)
			makeShaft(-axisY, TOFFSET, GREEN) makeTip(-axisY, TOFFSET, GREEN, "PosY", axisY)
			makeShaft( axisZ, TOFFSET, BLUE)  makeTip( axisZ, TOFFSET, BLUE,  "PosZ", axisZ)
			makeShaft(-axisZ, TOFFSET, BLUE)  makeTip(-axisZ, TOFFSET, BLUE,  "PosZ", axisZ)
			Gimbal.handleData["__apply"] = function()
				local showPos = (Gimbal.handleData["__mode"] or "pos") == "pos"
				for _, h in ipairs(Gimbal.handles) do
					local hd = Gimbal.handleData[h]
					if hd then
						if hd.isShaft then
							h.Transparency = showPos and 0.3 or 1.0
						elseif not hd.isRotate then  
							h.Transparency = showPos and 0.15 or 1.0
							h.CanQuery     = showPos
						end
					end
				end
			end
			Gimbal.handleData["__apply"]()  
			local posAxisW = Vector3.new(1, 0, 0)
			local posS     = 0.003
			table.insert(Gimbal.inputConns, mouse.Button1Down:Connect(function()
				local tgt = mouse.Target
				if not tgt or not Gimbal.handleData[tgt] then return end
				local hd = Gimbal.handleData[tgt]
				if hd.isShaft or hd.isRotate then return end  
				if pushUndoSnapshot then pushUndoSnapshot() end
				Gimbal.activeHandle = tgt
				Gimbal.dragging     = true
				Gimbal.dragLastX    = mouse.X
				Gimbal.dragLastY    = mouse.Y
				local go0 = PlayerData[SelectPlayer] and PlayerData[SelectPlayer].GizmoOffset or {}
				local rot_cf = go0.RotCF or CFrame.new()
				local bf = part.CFrame * rot_cf:Inverse()
				posAxisW = bf:VectorToWorldSpace(hd.posAxisLocal)
			end))
			table.insert(Gimbal.inputConns, mouse.Move:Connect(function()
				if not Gimbal.dragging or not Gimbal.activeHandle then return end
				local go = PlayerData[SelectPlayer] and PlayerData[SelectPlayer].GizmoOffset
				if not go then return end
				local hd = Gimbal.handleData[Gimbal.activeHandle]
				if not hd or hd.isRotate then return end
				local prevX     = Gimbal.dragLastX
				local prevY     = Gimbal.dragLastY
				Gimbal.dragLastX = mouse.X
				Gimbal.dragLastY = mouse.Y
				local dx = mouse.X - prevX
				local dy = mouse.Y - prevY
				if dx == 0 and dy == 0 then return end
				local cam2  = workspace.CurrentCamera
				local cR    = cam2.CFrame.RightVector
				local cU    = cam2.CFrame.UpVector
				local delta = (cR * dx + cU * (-dy)):Dot(posAxisW)
				go[hd.key] = math.clamp((go[hd.key] or 0) + delta * posS, -2, 2)
				for _, r in ipairs(GizmoSliderRefreshers) do pcall(r) end
			end))
			table.insert(Gimbal.inputConns, UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Gimbal.dragging     = false
					Gimbal.activeHandle = nil
				end
			end))
			table.insert(Gimbal.inputConns, UIS.WindowFocusReleased:Connect(function()
				Gimbal.dragging     = false
				Gimbal.activeHandle = nil
			end))
		end
		table.insert(AllConnect, RS.Heartbeat:Connect(function()
			local pd = PlayerData[SelectPlayer]
			if (not pd or not pd.GizmoTarget) and not Gimbal.adornPart then return end
			if Gimbal.adornPart and Gimbal.adornPart.Parent and pd and pd.GizmoTarget == Gimbal.cachedTarget then
				local _curCF = Gimbal.adornPart.CFrame
				local _curP = _curCF.Position
				local _curL = _curCF.LookVector
				if Gimbal._lastP and Gimbal._lastL
					and math.abs(Gimbal._lastP.X - _curP.X) < 1e-4
					and math.abs(Gimbal._lastP.Y - _curP.Y) < 1e-4
					and math.abs(Gimbal._lastP.Z - _curP.Z) < 1e-4
					and Gimbal._lastL:Dot(_curL) > 0.99999 then
					return
				end
				Gimbal._lastP = _curP
				Gimbal._lastL = _curL
			else
				Gimbal._lastP = nil  
				Gimbal._lastL = nil
			end
			rebuildGimbal()
		end))
	end
