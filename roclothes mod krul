local _physicsTickCtx = {}
local function _doPhysicsTickPart(ctx, Part, Property)
	if not Part or not Part.Parent or not Property.Base or not Property.Base.Parent or not Property.Weld or not Property.Weld.Parent then
		return
	end
	if ctx.Function.FallenPartCheck(Part) then
		ctx.DataList.CurrentPartList.BodyPartPhysics[Part] = nil
		return
	end
	local Character = ctx.DataList.Character
	local Human = Character and Character:FindFirstChildOfClass("Humanoid")
	if not Character or not Human then return end
	local Base = Property.Base
	local CurrentCFrame = Base.CFrame
	local OriginCFrame = Property.OriginCFrame
	local OriginPosition = OriginCFrame.Position
	local CurrentPosition = CurrentCFrame.Position
	local PositionDistance = (OriginPosition - CurrentPosition)
	if (ctx._camPos - Base.Position).Magnitude < 300
		and (PositionDistance.Magnitude < math.max(Human.WalkSpeed/8,1) or PositionDistance.Magnitude <= Base.AssemblyLinearVelocity.Magnitude) then
		local Weld = Property.Weld
		local CF = Property.CF
		local CF1 = Property.CF1
		local Spring = Property.Spring
		local PositionOffset = Property.PositionOffset
		local RotationOffset = Property.RotationOffset
		local Position = Property.Position
		local Rotation = Property.Rotation
		local OriginLookVector = OriginCFrame.LookVector
		local CurrentLookVector = CurrentCFrame.LookVector
		local LookVectorAxis = (OriginLookVector - CurrentLookVector)
		Spring:TimeSkip(ctx.d)
		Spring:Impulse(PositionDistance + LookVectorAxis
			+ ctx._inertiaImpulse
			+ Vector3.new(0, ctx._landImpulse, 0))
		local _poX, _poY, _poZ = Property._poX_to, Property._poY_to, Property._poZ_to
		local _PPM = ctx.PositionPhysicsMultiply
		local _sv = Spring.Velocity
		local posX = _poX and (Position[_poX] * _sv[_poX]) * _PPM or 0
		local posY = _poY and (Position[_poY] * _sv[_poY]) * _PPM or 0
		local posZ = _poZ and (Position[_poZ] * _sv[_poZ]) * _PPM or 0
		local _roX, _roY, _roZ = Property._roX_to, Property._roY_to, Property._roZ_to
		local _rmul = ctx._radMul
		local rotX = _roX and Rotation[_roX] * _sv[_roX] * _rmul or 0
		local rotY = _roY and Rotation[_roY] * _sv[_roY] * _rmul or 0
		local rotZ = _roZ and Rotation[_roZ] * _sv[_roZ] * _rmul or 0
		Weld.C0 = CF * (
			CFrame.new(posX, posY, posZ) *
			CFrame.Angles(rotX, rotY, rotZ)
		)
		if Property.Spring2 then
			Property.Spring2:TimeSkip(ctx.d)
			Property.Spring2:Impulse(
				(PositionDistance + LookVectorAxis + ctx._inertiaImpulse) * ctx._overtoneAmp)
			local ov = Property.Spring2.Velocity
			if ov:Dot(ov) > 400 then Property.Spring2.Velocity = ov.Unit * 20 end  
			Weld.C0 = Weld.C0 * CFrame.Angles(
				ov.X * ctx._radMulOvt,
				ov.Y * ctx._radMulOvt,
				ov.Z * ctx._radMulOvt)
		end
		if ctx._breathEnabled and ctx._horizSpeed < 2.0 then
			local _bPhase = (Part.Name == "Left Breast" or Part.Name == "Left Butt") and 0 or 0.3
			Weld.C0 = Weld.C0 * CFrame.new(0, math.sin(ctx._breathAccum * ctx._halfPi + _bPhase) * ctx._breathAmplitude, 0)
		end
		if ctx._physGravity then
			if Part.Name == "Left Breast" then
				Part:AddTag("AppliedPhysics")
				local frame = Base.CFrame
				if Property.BreastsType == 2 or Property.BreastsType == 6 then
					Weld.C1 = CF1 * CFrame.Angles(math.abs(OriginLookVector.Y)*-math.clamp(frame.LookVector.Y,-math.huge,.35) + frame.LookVector.Y*.15, 0, -frame.RightVector.Y)
				elseif Property.BreastsType == 3 then
					Weld.C1 = CF1 * CFrame.Angles((-frame.LookVector.Y*.2)-frame.RightVector.Y, 0, math.abs(OriginLookVector.Y)*math.clamp(frame.LookVector.Y,-math.huge,.35))
				elseif Property.BreastsType == 5 then
					Weld.C1 = CF1 * CFrame.Angles(math.abs(OriginLookVector.Y)*math.clamp(frame.LookVector.Y,-math.huge,.35), 0, frame.RightVector.Y)
				else
					Weld.C1 = CF1 * CFrame.Angles((frame.LookVector.Y*.2)+frame.RightVector.Y, 0, math.abs(OriginLookVector.Y)*-math.clamp(frame.LookVector.Y,-math.huge,.35))
				end
			elseif Part.Name == "Right Breast" then
				Part:AddTag("AppliedPhysics")
				local frame = Base.CFrame
				if Property.BreastsType == 2 or Property.BreastsType == 6 then
					Weld.C1 = CF1 * CFrame.Angles(math.abs(OriginLookVector.Y)*-math.clamp(frame.LookVector.Y,-math.huge,.35) - frame.LookVector.Y*.15, 0, -frame.RightVector.Y)
				elseif Property.BreastsType == 3 then
					Weld.C1 = CF1 * CFrame.Angles((frame.LookVector.Y*.2)-frame.RightVector.Y, 0, math.abs(OriginLookVector.Y)*math.clamp(frame.LookVector.Y,-math.huge,.35))
				elseif Property.BreastsType == 5 then
					Weld.C1 = CF1 * CFrame.Angles(math.abs(OriginLookVector.Y)*math.clamp(frame.LookVector.Y,-math.huge,.35), 0, frame.RightVector.Y)
				else
					Weld.C1 = CF1 * CFrame.Angles((-frame.LookVector.Y*.2)+frame.RightVector.Y, 0, math.abs(OriginLookVector.Y)*-math.clamp(frame.LookVector.Y,-math.huge,.35))
				end
			elseif Part.Name == "Breasts Shirt" or Part.Name == "Breasts Pants" then
				local frame = Base.CFrame
				Weld.C1 = CF1 * CFrame.Angles(frame.RightVector.Y, 0, math.abs(OriginLookVector.Y)*-math.clamp(frame.LookVector.Y,-math.huge,.42))
			end
		elseif Part:HasTag("AppliedPhysics") then
			if Part.Name == "Left Breast" or Part.Name == "Right Breast" or Part.Name == "Breasts Shirt" or Part.Name == "Breasts Pants" then
				Weld.C1 = CF1
				Part:RemoveTag("AppliedPhysics")
			end
		end
	end
	Property.OriginCFrame = CurrentCFrame
end
