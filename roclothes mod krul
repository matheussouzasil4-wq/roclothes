	function Function.AccessoryAdd(Character, v, CharacterAttachment, Data)
		local DataDetail = PlayerData[Data]
		local CAccessory = v:Clone()
		local CHandle = CAccessory:FindFirstChildOfClass("Part") or CAccessory:FindFirstChildOfClass("MeshPart")
		if not CHandle then return end
		local CAttachment = CHandle:FindFirstChildOfClass("Attachment")
		if not CAttachment then return end
		local CSpecialMesh = CHandle:FindFirstChildOfClass("SpecialMesh")
		CAccessory:AddTag(System.RCTag)
		Function.ApplyAssets(CAccessory)
		DataDetail.ExecutionMaid:Give(CAccessory)
		DataDetail.CurrentPartList["Accessory"][CAccessory] = CAccessory
		if isTailAccessory(CAccessory) then
			setUpTailAccessory(Character, CAccessory, Data)
		end
		local CParentAttachment = CharacterAttachment[CAttachment.Name]
		if CParentAttachment then
			local HandleParent = CParentAttachment.Parent
			local Size = HandleParent.Size
			local HandleSize = CHandle.Size
			local BodySize = BodyPartSize[HandleParent.Name]
			local CalcSize = Size
			local specialHead = false
			if not BodySize then
				if HandleParent.Name == "UpperTorso" or HandleParent.Name == "LowerTorso" then
					BodySize = BodyPartSize["Torso"]
				elseif HandleParent.Name == "LeftUpperArm" or HandleParent.Name == "LeftLowerArm" then 
					BodySize = BodyPartSize["Left Arm"]
				elseif HandleParent.Name == "RightUpperArm" or HandleParent.Name == "RightLowerArm" then
					BodySize = BodyPartSize["Right Arm"]
				elseif HandleParent.Name == "LeftUpperLeg" or HandleParent.Name == "LeftLowerLeg" then
					BodySize = BodyPartSize["Left Leg"]
				elseif HandleParent.Name == "RightUpperLeg" or HandleParent.Name == "RightLowerLeg" then
					BodySize = BodyPartSize["Right Leg"]
				end
			elseif HandleParent.Name == "Head" and HandleParent:IsA("MeshPart") then
				if HandleParent:FindFirstChild("OriginalSize") then
					BodySize = HandleParent:FindFirstChild("OriginalSize").Value
				else
					BodySize = BodyPartSize["HeadMeshFix"]
				end
			elseif HandleParent.Name == "Head" and HandleParent:FindFirstChildOfClass("SpecialMesh") then
				local SM:SpecialMesh = HandleParent:FindFirstChildOfClass("SpecialMesh")
				if SM.MeshType == Enum.MeshType.Head then
					specialHead = true
					BodySize = BodyPartSize["HeadScale"]
				else
					CalcSize = SM.Scale
					BodySize = BodyPartSize["HeadScale"]
				end
			end
			local XMultiply, YMultiply, ZMultiply = Function.MultiplyCalculate(CalcSize, BodySize)
			if specialHead == true then
				local SM:SpecialMesh = HandleParent:FindFirstChildOfClass("SpecialMesh")
				if CalcSize.X > CalcSize.Z then
					CalcSize = Vector3.new(CalcSize.Z,CalcSize.Y,CalcSize.Z)
				end
				if CalcSize.Z > CalcSize.X then
					CalcSize = Vector3.new(CalcSize.X,CalcSize.Y,CalcSize.X)
				end
				XMultiply, YMultiply, ZMultiply = Function.MultiplyCalculate(CalcSize, BodySize)
				local S = SM.Scale
				if S.X > S.Z then
					S = Vector3.new(S.Z,S.Y,S.Z)
				end
				if S.Z > S.X then
					S = Vector3.new(S.X,S.Y,S.X)
				end
				local XMS, YMS, ZMS = Function.MultiplyCalculate(S, vector3New(1.25,1.25,1.25))
				XMultiply = XMultiply*XMS
				YMultiply = YMultiply*YMS
				ZMultiply = ZMultiply*ZMS
			end
			local CAttachCF = CAttachment.CFrame
			local PAttachCF = AttachmentCFrame[CParentAttachment.Name]
			local Scale = CSpecialMesh and CSpecialMesh.Scale or Vector3.one
			if DataDetail.OriginalAttachmentCFrames == nil then
				DataDetail.OriginalAttachmentCFrames = {}
			end
			if DataDetail.OriginalAttachmentCFrames[CParentAttachment] == nil then
				DataDetail.OriginalAttachmentCFrames[CParentAttachment] = CParentAttachment.CFrame
			end
			if DataDetail.AccessorySizeLock == false then
				CHandle.Size = Vector3.new(HandleSize.X * XMultiply, HandleSize.Y * YMultiply, HandleSize.Z * ZMultiply)
				if CSpecialMesh then
					CSpecialMesh.Scale = Vector3.new(Scale.X * XMultiply, Scale.Y * YMultiply, Scale.Z * ZMultiply)
				end
				CAttachment.CFrame = CFrame.new(CAttachCF.Position.X * XMultiply, CAttachCF.Position.Y * YMultiply, CAttachCF.Position.Z * ZMultiply) * CAttachCF.Rotation
				if not DataDetail.CurrentPartList.physicsTails[CAccessory] then
					CParentAttachment.CFrame = CFrame.new(PAttachCF.Position.X * XMultiply, PAttachCF.Position.Y * YMultiply, PAttachCF.Position.Z * ZMultiply) * PAttachCF.Rotation
				end
			else
				CHandle.Size = HandleSize
				if CSpecialMesh then
					CSpecialMesh.Scale = Scale
				end
			end
			CHandle.CanCollide = false
			CHandle.CanQuery = false
			CHandle.CanTouch = false
			CHandle.Massless = true
			CHandle.CustomPhysicalProperties = System.Physics.DefaultProperties
			CAccessory.Parent = Character
			v:Destroy()
			CHandle.CFrame = CParentAttachment.Parent.CFrame
			local Weld = Instance.new("Weld", CHandle)
			Weld.Part0 = CHandle
			Weld.Part1 = CParentAttachment.Parent
			Weld.C0 = CAttachment.CFrame
			Weld.C1 = CParentAttachment.CFrame
			local detectRemoval
			detectRemoval = CHandle.ChildRemoved:Connect(function(c)
				if CHandle.Parent ~= nil then
					if c:IsA("Weld") and c.Part0 == CHandle then
						Function.TryRecloneWeld(CHandle, c)
					end
				else
					detectRemoval:Disconnect()
					local idx = table.find(AllConnect, detectRemoval)
					if idx then table.remove(AllConnect, idx) end
				end
			end)
			table.insert(AllConnect,detectRemoval)
			DataDetail.CurrentPartList.RealtimeUpdateList.Accessory[CHandle] = {Scale = Scale, SpecialMesh = CSpecialMesh, Size = Size, CFrame = CAttachCF, Attachment = CAttachment, ParentAttachment = CParentAttachment, Base = HandleParent, Weld = Weld}
		end
	end
	function Function.HumanoidDescriptionSet(AccessoryList, ClothesList, HumanoidDescription, Data, RequestID)
		local IsAdded = false
		if AccessoryList ~= nil then
			local amountFinished = 0
			Function._knownDeadIds = Function._knownDeadIds or {}
			local _deadCount = 0
			local _liveCount = 0
			for _, Id in pairs(AccessoryList) do
				local _idNum = tonumber(Id)
				if not _idNum or _idNum <= 0 or _idNum ~= math.floor(_idNum) or _idNum >= 2^53 then
					warn('[RoClothes] Skipping invalid accessory ID: '..tostring(Id))
					continue
				end
				if Function._knownDeadIds[_idNum] then
					_deadCount = _deadCount + 1
					continue
				end
				_liveCount = _liveCount + 1
				task.spawn(function()
					local success, output = pcall(function()
						local cachedTypeId = Function._catalogAssetTypeCache and
							Function._catalogAssetTypeCache[tonumber(Id) or Id]
						local typeId
						if cachedTypeId then
							typeId = cachedTypeId
						else
							local AccessoryInfo = MPS:GetProductInfo(Id)
							typeId = AccessoryInfo.AssetTypeId
							if Function._catalogAssetTypeCache and typeId then
								Function._catalogAssetTypeCache[tonumber(Id) or Id] = typeId
							end
						end
						local Type = AccessoryType[typeId]
						if Type == nil then
							if Function._catalogAssetTypeCache then
								Function._catalogAssetTypeCache[tonumber(Id) or Id] = nil
							end
							error("__UNMAPPED__[RoClothes] Accessory ID " .. tostring(Id) .. " has unmapped AssetTypeId=" .. tostring(typeId) .. " — Roblox added a new accessory class or this isn't an Accessory asset.")
						end
						if HumanoidDescription[Type] == "" then
							HumanoidDescription[Type] = Id
						else
							HumanoidDescription[Type] = HumanoidDescription[Type]..", "..Id
						end
					end)
					if not success then
						local _outStr = tostring(output)
						local _isUnmapped = _outStr:find("__UNMAPPED__", 1, true) ~= nil
						local _idn = tonumber(Id)
						if _idn and not _isUnmapped then
							local _n = 0
							for _ in pairs(Function._knownDeadIds) do _n = _n + 1 end
							if _n >= 4096 then
								for k in pairs(Function._knownDeadIds) do Function._knownDeadIds[k] = nil; break end
							end
							Function._knownDeadIds[_idn] = true
							Function._knownDeadIdsDirty = true  
						end
						if _isUnmapped then
							warn('Accessory ID "'..Id..'" has unmapped AssetType — not cached as dead, will retry on next equip. ('.. _outStr .. ")")
						else
							warn('Accessory ID "'..Id..'" is invalid. Please make sure ID is an ACCESSORY and is not content deleted. ('.. _outStr .. ")")
						end
					else
						IsAdded = true
					end
					amountFinished +=1
				end)
			end
			if _deadCount > 0 then
				warn('[RoClothes] Bundle skipped '..tostring(_deadCount)..' known-dead accessory ID(s); '..tostring(_liveCount)..' live ID(s) queued')
			end
			local _alLen = _liveCount  
			local _waitStart = (tick and tick()) or os.clock()  
			repeat task.wait() until amountFinished >= _alLen
				or (((tick and tick()) or os.clock()) - _waitStart) > 5  
				or (RequestID and Data and PlayerData[Data] and RequestID ~= PlayerData[Data].LastRequestID)
		end
		if ClothesList ~= nil then
			for Type, Id in pairs(ClothesList) do
				if Id ~= "" and Id ~= 0 and Id ~= "0" then
					if Type == "Shirt" then
						HumanoidDescription.Shirt = Id
					elseif Type == "Pants" then
						HumanoidDescription.Pants = Id
					elseif Type == "ShirtGraphic" then
						HumanoidDescription.GraphicTShirt = Id
					end
					IsAdded = true
				end
			end
		end
		return IsAdded
	end
	function Function.HumanoidDescriptionLoader(Character, HumanoidDescription, CharacterAttachment, UseBodyColor, Data, isCatalogUsername, oChar, tailCheck, RequestID, MethodOverride)
		local _Method = MethodOverride or Method
		local DataDetail = PlayerData[Data]
		if not DataDetail then return end
		local function _runHDApply(_attemptDescription, _maxFrames)
			local _model = Instance.new("Model", game)  
			_model.Archivable = not hidden
			pcall(function() _model:AddTag(System.RCTag) end)
			local _humanoid = Instance.new("Humanoid", _model)
			local _lastAddFrame = 0
			local _frameCount = 0
			local _addedConn
			_addedConn = _model.ChildAdded:Connect(function() _lastAddFrame = _frameCount end)
			local _applyOk, _applyErr = pcall(function() _humanoid:ApplyDescription(_attemptDescription) end)
			if not _applyOk then
				if _addedConn then _addedConn:Disconnect() end
				_model:Destroy()
				warn("[RoClothes] ApplyDescription threw — likely content-deleted accessory in bundle: "..tostring(_applyErr))
				return nil, "applyerror"
			end
			local _firstAddFrame = -1
			_addedConn:Disconnect()
			_addedConn = _model.ChildAdded:Connect(function()
				_lastAddFrame = _frameCount
				if _firstAddFrame < 0 then _firstAddFrame = _frameCount end
			end)
			repeat
				task.wait()
				_frameCount += 1
				if not PlayerData[Data] then
					if _addedConn then _addedConn:Disconnect() end
					_model:Destroy()
					return nil, "stale"
				end
				local _kids = #_model:GetChildren()
				local _idleFrames = _frameCount - _lastAddFrame
				if _kids > 2 and _idleFrames >= 4 then break end
				if _kids <= 2 and _idleFrames >= 40 then
					if _addedConn then _addedConn:Disconnect() end
					_model:Destroy()
					return nil, "noadds"
				end
				if _firstAddFrame >= 0 and (_frameCount - _firstAddFrame) >= 180 then break end
			until _frameCount >= _maxFrames
				or (RequestID and PlayerData[Data] and RequestID ~= PlayerData[Data].LastRequestID)
			if _addedConn then _addedConn:Disconnect() end
			local _pdNow = PlayerData[Data]
			if not _pdNow or (RequestID and RequestID ~= _pdNow.LastRequestID) then
				_model:Destroy()
				return nil, "stale"
			end
			if _frameCount >= _maxFrames then
				_model:Destroy()
				return nil, "timeout"
			end
			return _model, nil
		end
		local AccessoryLoaderModel, _err = _runHDApply(HumanoidDescription, 400)
		if not AccessoryLoaderModel and _err == "timeout" then
			warn("[RoClothes] HumanoidDescriptionLoader timed out — retrying once (short attempt)")
			local _retryDesc = HumanoidDescription
			local _okClone, _cloned = pcall(function() return HumanoidDescription:Clone() end)
			if _okClone and _cloned then _retryDesc = _cloned end
			AccessoryLoaderModel, _err = _runHDApply(_retryDesc, 100)  
			if _retryDesc ~= HumanoidDescription then pcall(function() _retryDesc:Destroy() end) end
		end
		if not AccessoryLoaderModel then
			if _err == "timeout" then
				warn("[RoClothes] HumanoidDescriptionLoader timed out after retry — accessories will retry on next CharacterExecute")
			elseif _err == "applyerror" then
				warn("[RoClothes] HumanoidDescriptionLoader: bundle has content-deleted accessory IDs — partial apply only")
			elseif _err == "noadds" then
				warn("[RoClothes] HumanoidDescriptionLoader: no accessories landed (all content-deleted or invalid IDs) — bundle will show partial")
			end
			HumanoidDescription:Destroy()
			return
		end
		if not PlayerData[Data] then
			AccessoryLoaderModel:Destroy()
			HumanoidDescription:Destroy()
			return
		end
		if Function.IsStaleOrGone(Data, RequestID) then  
			AccessoryLoaderModel:Destroy()
			HumanoidDescription:Destroy()
			return
		end
		local function _snapshotOriginalBodyColors()
			Function.SnapshotOriginalBodyColors(DataDetail, Character)
		end
		local _appliedBC = false
		for _, v in pairs(AccessoryLoaderModel:GetChildren()) do
			if v:IsA("Accessory") then
				if tailCheck == true then
					v.Name = v.Name.."RCTailCertified"
				end
				pcall(function() v:SetAttribute("_RC_FromHD", true) end)
				Function.AccessoryAdd(Character, v, CharacterAttachment, Data)
			elseif v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
				local function convertId(id)
					local success, decalObject = pcall(function()
						local decalObject = game:GetObjects("rbxassetid://"..id)[1]
						return decalObject
					end)
					if success and decalObject and decalObject:IsA("Decal") then
						return decalObject.Texture
					elseif string.gsub(id,"%D","") == tostring(id) then
						warn("Clothing ID ".. id.. " returned as invalid clothing! Decal method was detected invalid as well."..
							" If you're using an image ID, this is a false positive.")
						return "rbxassetid://".. id
					else
						return id
					end
				end
				if v:IsA("Shirt") and string.gsub(v.ShirtTemplate,"%D","") == "855777285" and HumanoidDescription.Shirt then
					v.ShirtTemplate = convertId(HumanoidDescription.Shirt)
				elseif v:IsA("Pants") and string.gsub(v.PantsTemplate,"%D","") == "867826313" and HumanoidDescription.Pants then
					v.PantsTemplate = convertId(HumanoidDescription.Pants)
				end
				local OldCloth = Character:FindFirstChildOfClass(v.ClassName)
				if OldCloth then
					if DataDetail.OldestClothings[v.ClassName] == nil then
						DataDetail.OldestClothings[v.ClassName] = OldCloth:Clone()
					end
					OldCloth:Destroy()
				end
				v.Parent = Character
			elseif v:IsA("BodyColors") and UseBodyColor == true then
				_snapshotOriginalBodyColors()
				local OldBC = Character:FindFirstChildOfClass("BodyColors")
				if OldBC then
					OldBC:Destroy()
				end
				v.Parent = Character
				Function.BodyColorSet(Character, v)
				_appliedBC = true  
				if (not RequestID) or (PlayerData[Data] and RequestID == PlayerData[Data].LastRequestID) then
					DataDetail._catalogAppliedBodyColor = true
				end
			end
		end
		if UseBodyColor == true and not _appliedBC then
			local _hdHead = HumanoidDescription.HeadColor
			local _hdTorso = HumanoidDescription.TorsoColor
			if _hdHead and _hdTorso then
				_snapshotOriginalBodyColors()
				local _snap = DataDetail.OriginalBodyColors
				local function _colorEq(a, b)
					if not a or not b then return a == b end
					return a.R == b.R and a.G == b.G and a.B == b.B
				end
				local _diff = _snap and (
					not _colorEq(_hdHead,  _snap.HeadColor3)
					or not _colorEq(_hdTorso, _snap.TorsoColor3)
					or not _colorEq(HumanoidDescription.LeftArmColor  or _hdTorso, _snap.LeftArmColor3)
					or not _colorEq(HumanoidDescription.RightArmColor or _hdTorso, _snap.RightArmColor3)
					or not _colorEq(HumanoidDescription.LeftLegColor  or _hdTorso, _snap.LeftLegColor3)
					or not _colorEq(HumanoidDescription.RightLegColor or _hdTorso, _snap.RightLegColor3)
				)
				if _diff then
				local OldBC = Character:FindFirstChildOfClass("BodyColors")
				if OldBC then OldBC:Destroy() end
				local NewBC = Instance.new("BodyColors", Character)
				NewBC.HeadColor3     = _hdHead
				NewBC.TorsoColor3    = _hdTorso
				NewBC.LeftArmColor3  = HumanoidDescription.LeftArmColor  or _hdTorso
				NewBC.RightArmColor3 = HumanoidDescription.RightArmColor or _hdTorso
				NewBC.LeftLegColor3  = HumanoidDescription.LeftLegColor  or _hdTorso
				NewBC.RightLegColor3 = HumanoidDescription.RightLegColor or _hdTorso
				Function.BodyColorSet(Character, NewBC)
				_appliedBC = true
				if (not RequestID) or (PlayerData[Data] and RequestID == PlayerData[Data].LastRequestID) then
					DataDetail._catalogAppliedBodyColor = true
				end
				end 
			end
		end
		if isCatalogUsername == true then
			if Character:FindFirstChild("Head") then
				local LoadedAvatar = game:GetService("Players"):CreateHumanoidModelFromDescription(HumanoidDescription, Enum.HumanoidRigType.R6)
				local head = LoadedAvatar:WaitForChild("Head", 5)
				if not head then
					LoadedAvatar:Destroy()
					AccessoryLoaderModel:Destroy()
					HumanoidDescription:Destroy()
					return
				end
				if Function.IsStaleOrGone(Data, RequestID) then  
					LoadedAvatar:Destroy()
					AccessoryLoaderModel:Destroy()
					HumanoidDescription:Destroy()
					return
				end
				if not PlayerData[Data] then
					LoadedAvatar:Destroy()
					AccessoryLoaderModel:Destroy()
					HumanoidDescription:Destroy()
					return
				end
				local charHead = Character:FindFirstChild("Head")
				local OldFC = charHead:FindFirstChildOfClass("Decal")
				local OldSM = charHead:FindFirstChildOfClass("SpecialMesh")
				if charHead:IsA("MeshPart") then
					local v = charHead
					local newHead = Instance.new("Part",v)
					newHead:AddTag(System.RCTag)
					newHead.Size = v.Size
					newHead.Name = "RCFake"..v.Name
					newHead.CanCollide = false
					newHead.CanQuery = false
					newHead.CanTouch = false
					newHead.Massless = true
					newHead.CustomPhysicalProperties = System.Physics.DefaultProperties
					newHead.Color = v.Color
					newHead.Material = v.Material
					newHead.Reflectance = v.Reflectance
					DataDetail.CurrentPartList.Organ["Head"] = newHead
					DataDetail.CurrentPartList.Link[newHead] = {T=v, Color=v}
					newHead.CFrame = v.CFrame
					local Weld = Instance.new("Weld", newHead)
					Weld.Part0 = v
					Weld.Part1 = newHead
					if DataDetail.Face == true then
						if head:FindFirstChildOfClass("Decal") then
							if OldFC then
								OldFC:Destroy()
							end
							local newDC=head:FindFirstChildOfClass("Decal"):Clone()
							newDC.Parent = newHead
							DataDetail.CurrentPartList.Link[newDC] = {T=newHead}
						elseif OldFC then
							OldFC.Parent = newHead
						end
					elseif OldFC then
						OldFC:Destroy()
					end
					if head:FindFirstChildOfClass("SpecialMesh") then
						DataDetail.CurrentPartList.ParentTransparency[v] = {v = v.Transparency, T = 1}
						local mesh = head:FindFirstChildOfClass("SpecialMesh"):Clone()
						mesh.Parent = newHead
						if mesh.MeshType == Enum.MeshType.Head then
							mesh.Scale = Vector3.new(1,1,1)
						end
						DataDetail.CurrentPartList.RealtimeUpdateList.SpecialMesh[mesh] = {
							Base=v,
							Size=mesh.Scale,
							CFrame = CFrame.new(0,0,0),
							CFrame1 = CFrame.new(0,0,0),
							Weld = Weld,
						}
					else
						local mesh = Instance.new("SpecialMesh",newHead)
						mesh.MeshId = v.MeshId
					end
				elseif _Method == 2 and oChar then  
					local h = Character:FindFirstChild("Head")
					local function newhed(id,texture)
						local newHead = Function.CachedCreateMeshPartAsync(id,
							Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
						if not newHead then
							newHead = Function.CachedCreateMeshPartAsync("rbxasset://fonts//head.mesh",
								Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
						end
						if Function.IsStaleOrGone(Data, RequestID) then  
							if newHead then pcall(function() newHead:Destroy() end) end
							return nil
						end
						newHead.Parent = h
						local appearance = Instance.new("SurfaceAppearance",newHead)
						appearance.ColorMap = texture
						newHead:AddTag("ImportantSurfaceAppearance")
						newHead:AddTag(System.RCTag)
						newHead.Name = h.Name
						newHead.CanCollide = false
						newHead.CanQuery = false
