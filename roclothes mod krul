	function Function.Converter(Character, Data, RequestID, MethodOverride)
		local _Method = MethodOverride or Method
		local DataDetail = PlayerData[Data]
		if not DataDetail then return end
		for _, v in pairs(Character:GetChildren()) do
			if v:IsA("BasePart") and R15Transparency[v.Name] then
				DataDetail.CurrentPartList.ParentTransparency[v] = {D=0,T=1}
			end
		end
		if Character:FindFirstChild("UpperTorso") and not Character:FindFirstChild("Torso") then
			for New, Base in pairs(ConvertPart) do
				local BasePart = Character:FindFirstChild(Base)
				if BasePart then
					local Part
					if New == "Torso" then
						Part = Function.CachedCreateMeshPartAsync(R6Mesh[New.."Female"],
							Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
					else
						Part = Function.CachedCreateMeshPartAsync(R6Mesh[New],
							Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
					end
					if not Part then return end  
					if Function.IsStaleOrGone(Data, RequestID) then return end  
					Part.Name = New
					Part.Color = BasePart.Color
					Part.CanCollide = false
					Part.CanQuery = false
					Part.CanTouch = false
					Part.Massless = true
					Part.CustomPhysicalProperties = DefaultProperties
					Part.Size = R6Size[New]
					Part.Material = Mappings.SmoothPlastic
					Part:SetAttribute("Visibility",1)
					Part:AddTag("Visibility")
					Part.CFrame = BasePart.CFrame
					local Weld = Instance.new("Weld", Part)
					Weld.Part0 = BasePart
					Weld.Part1 = Part
					Weld.C0 = WeldCFrame[New]
					Part.Parent = Character
					if _Method == 2 then Part.LocalTransparencyModifier = 1 end  
					Part:AddTag(System.RCTag)
					DataDetail.ConvertedPart[New] = {Part = Part, Weld = Weld, Base = BasePart}
				end
			end
		elseif Character:FindFirstChild("UpperTorso") and Character:FindFirstChild("Torso") then
			for i, v in pairs(DataDetail.ConvertedPart) do
				v.Part.Transparency = 0
				v.Part:SetAttribute("Visibility",1)
				v.Part:AddTag("Visibility")
			end
		end
	end
	function Function.CharacterExecute(Character, Data, bool, RequestID)
		local DataDetail = PlayerData[Data]
		if not DataDetail then return end
		DataDetail._catalogAppliedBodyColor = nil
		local _MethodAtExec = Method
		DataDetail.MethodAtBuild = _MethodAtExec
		if DataDetail.ExecutionMaid then
			DataDetail.ExecutionMaid:DoCleaning()
		end
		DataDetail.ExecutionMaid = Maid.new()
		task.defer(function()
			local _ceOk, _ceErr = pcall(function()
			if Function.IsStaleOrGone(Data, RequestID) then return end  
			if UIS and UIS.TouchEnabled and not UIS.KeyboardEnabled then
				task.wait()
			end
			if not Character or not Function.CharacterIsBuilt(Character) then
				local count = 0
				repeat
					task.wait(0.05)
					count = count + 1
				until Function.CharacterIsBuilt(Character) or count > 100
					or Function.IsStaleOrGone(Data, RequestID)  
				if Function.IsStaleOrGone(Data, RequestID) then return end  
				if not Function.CharacterIsBuilt(Character) then
					warn("[RoClothes] CharacterExecute: character not fully built after 5s (streaming race); bundle apply skipped. Try clicking the bundle again.")
					return
				end
			end
			if Function.IsStaleOrGone(Data, RequestID) then return end  
			local Human = Character:FindFirstChildOfClass("Humanoid")
			if not Human then return end
			Function.PlayerDataAdd(Data)
			local DataDetail = PlayerData[Data]
			do
				local waitCount = 0
				while DataDetail.Cooldown == true and waitCount < 30 do
					if Function.IsStaleOrGone(Data, RequestID) then return end  
					task.wait()
					waitCount = waitCount + 1
				end
				if DataDetail.Cooldown == true then DataDetail.Cooldown = false end
			end
			if Function.IsStaleOrGone(Data, RequestID) then return end  
			DataDetail["Cooldown"] = true
			local function _bailIfStale()
				local _pd = PlayerData[Data]
				if not _pd then return true end  
				if RequestID and RequestID ~= _pd.LastRequestID then
					if _pd.Cooldown == true then _pd.Cooldown = false end
					return true
				end
				return false
			end
			pcall(Function.CharacterReset, Data)
			if _bailIfStale() then return end
				if _MethodAtExec == 2 and Character and Character.Parent ~= nil then  
					for _, v in pairs(Character:GetChildren()) do
						if v:IsA("BasePart") and v.Name ~= "Head" and (table.find(Method2BodyPart, v.Name) or v.Name == "HumanoidRootPart") then
							v.LocalTransparencyModifier = 1
						end
					end
				end
			DataDetail["Character"] = Character
			local _convOk, _convErr = pcall(Function.Converter, Character, Data, RequestID, _MethodAtExec)  
			if not _convOk then
				warn("[RoClothes] Converter error (mesh load failed):", _convErr)
				DataDetail["Cooldown"] = false return
			end
			if PlayerData[Data] ~= DataDetail then DataDetail["Cooldown"] = false return end
			if _bailIfStale() then return end
			Function.AttachmentCreate(Character)
			local CharacterAttachment = Function.CharacterFunction(Character, Data)
			if Human then
				DataDetail.SavedPreviousHP = Human.Health
				if DataDetail.TopHP ~= "" then
					DataDetail.SavedTopHP = DataDetail.TopHP
				end
				if DataDetail.BottomHP ~= "" then
					DataDetail.SavedBottomHP = DataDetail.BottomHP
				end
			end
			DataDetail.TopRipped = false
			DataDetail.BottomRipped = false
			local OldCharacter
			if _MethodAtExec == 2 then  
				OldCharacter = Character
				DataDetail.RealCharacter = Character
				if _bailIfStale() then return end
				Character = Method2CharacterFolder:FindFirstChild(Data)
				if Character then
					Character:Destroy()
					Character = nil
				end
				if not Character then
					Character = Instance.new("Model", Method2CharacterFolder)
					Character:AddTag(System.RCTag)
					Character.Archivable = not hidden
					Character.Name = Data
					local CharacterValue = Instance.new("ObjectValue", Character)
					CharacterValue.Value = OldCharacter
					for _, v in pairs(CharacterValue.Value:GetChildren()) do
						if _bailIfStale() then
							Character:Destroy() 
							return
