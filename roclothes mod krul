local function _buildPlayerDropdownPanel(ctx)
	local function setSelectPlayerByName(name)
		if name == "Self" then
			ctx.setSelectPlayer(ctx.Player.Name)
			ctx.clearLastMeshEditName()
			ctx.GUIObject.PlayerExecute.TextColor3 = Color3.new(1,1,1)
			ctx.Function.GUIUpdate()
			return true
		elseif ctx.PS:FindFirstChild(name) then
			ctx.setSelectPlayer(name)
			ctx.clearLastMeshEditName()
			ctx.GUIObject.PlayerExecute.TextColor3 = Color3.new(1,1,1)
			ctx.Function.PlayerDataAdd(name)
			ctx.Function.GUIUpdate()
			return true
		else
			ctx.GUIObject.PlayerExecute.TextColor3 = Color3.new(1,0,0)
			return false
		end
	end
	local playerDropdownFilter = ""
	local function positionPlayerDropdown()
		local abs = ctx.GUIObject.PlayerFrame.AbsolutePosition
		local sz  = ctx.GUIObject.PlayerFrame.AbsoluteSize
		local inset = 0
		if not ctx.GUIObject.Screen.IgnoreGuiInset then inset = 36 end
		local filterH = math.max(20, math.floor(sz.Y * 0.7))
		local filterY = abs.Y + sz.Y + 4 - inset
		ctx.GUIObject.PlayerDropdownFilter.Position = UDim2.fromOffset(abs.X, filterY)
		ctx.GUIObject.PlayerDropdownFilter.Size = UDim2.fromOffset(sz.X, filterH)
		ctx.GUIObject.PlayerDropdownFrame.Position = UDim2.fromOffset(abs.X, filterY + filterH + 2)
		ctx.GUIObject.PlayerDropdownFrame.Size = UDim2.fromOffset(sz.X, math.floor(sz.Y * 4.5))
	end
	local _playerDropdownConns = {}
	local function rebuildPlayerDropdown()
		for i = #_playerDropdownConns, 1, -1 do
			local _c = _playerDropdownConns[i]
			pcall(function() _c:Disconnect() end)
			local _idx = table.find(ctx.AllConnect, _c)
			if _idx then table.remove(ctx.AllConnect, _idx) end
			_playerDropdownConns[i] = nil
		end
		for _, child in pairs(ctx.GUIObject.PlayerDropdownFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local filterLower = playerDropdownFilter:lower()
		local entries = {}
		if filterLower == "" or ("self"):find(filterLower, 1, true) or ctx.Player.Name:lower():find(filterLower, 1, true) then
			table.insert(entries, "Self")
		end
		for _, plr in pairs(ctx.PS:GetPlayers()) do
			if filterLower == "" or plr.Name:lower():find(filterLower, 1, true) or (plr.DisplayName and plr.DisplayName:lower():find(filterLower, 1, true)) then
				table.insert(entries, plr.Name)
			end
		end
		table.sort(entries, function(a, b)
			if a == "Self" then return true end
			if b == "Self" then return false end
			return a:lower() < b:lower()
		end)
		for i, name in ipairs(entries) do
			local btn = Instance.new("TextButton")
			btn.Name = name
			btn.Parent = ctx.GUIObject.PlayerDropdownFrame
			btn.Size = UDim2.new(1, -4, 0, 24)
			btn.BackgroundColor3 = Color3.fromRGB(28, 18, 48)
			btn.BorderSizePixel = 0
			btn.ZIndex = 101
			btn.Font = Enum.Font.GothamMedium
			btn.TextColor3 = Color3.fromRGB(230, 230, 240)
			btn.TextScaled = true
			btn.Text = name == "Self" and ("Self (" .. ctx.Player.Name .. ")") or name
			btn.LayoutOrder = i
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.15, 0)
			corner.Parent = btn
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 4)
			pad.PaddingRight = UDim.new(0, 4)
			pad.Parent = btn
			local capturedName = name
			local conn = btn.MouseButton1Click:Connect(function()
				if setSelectPlayerByName(capturedName) then
					ctx.GUIObject.PlayerExecute.Text = capturedName
					ctx.GUIObject.PlayerDropdownFrame.Visible = false
					ctx.GUIObject.PlayerDropdownFilter.Visible = false
				end
			end)
			table.insert(ctx.AllConnect, conn)
			table.insert(_playerDropdownConns, conn)  
		end
	end
	ctx.GlobalMaid:Give(ctx.GUIObject.PlayerExecute:GetPropertyChangedSignal("Text"):Connect(function()
		setSelectPlayerByName(ctx.GUIObject.PlayerExecute.Text)
	end))
	table.insert(ctx.AllConnect, ctx.GUIObject.PlayerDropdownToggle.MouseButton1Click:Connect(function()
