					if not table.find(pd.CurrentClothes, cname) then
						table.insert(pd.CurrentClothes, cname)
					end
					pd.ClothesHP[cname] = nil
					local hp = Clothes[cname].HP
					if hp == 1 then
						pd.ClothesHP[cname] = {HP = "TopHP",    Inverse = false}
					elseif hp == 2 then
						pd.ClothesHP[cname] = {HP = "BottomHP", Inverse = false}
					elseif hp == 3 then
						pd.ClothesHP[cname] = {HP = "TopHP",    Inverse = true}
					elseif hp == 4 then
						pd.ClothesHP[cname] = {HP = "BottomHP", Inverse = true}
					elseif hp and hp ~= 0 then
