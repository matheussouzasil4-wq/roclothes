	local function _isScriptOwnedGui(child)
		if not child:IsA("ScreenGui") or child == gui then return false end
		local n = child.Name or ""
		return n:match("^ui_") ~= nil or n == "RoClothesCloseButton"
	end
	local _hidden = {}     
	local _propConns = {}  
	local function _maybeHide(child)
		if _cleaned then return end
		if not _isScriptOwnedGui(child) or _hidden[child] ~= nil then return end
		_hidden[child] = child.Enabled  
		child.Enabled = false
		local conn
		conn = child:GetPropertyChangedSignal("Enabled"):Connect(function()
			if _cleaned then return end
			if child.Enabled then
				_hidden[child] = true
				child.Enabled = false
			end
		end)
		table.insert(_propConns, conn)
	end
	local _watchSet, _watchList = {}, {}
	local function _addWatch(c)
		if c and not _watchSet[c] then _watchSet[c] = true; table.insert(_watchList, c) end
	end
	_addWatch(parentGui)
	_addWatch(game:GetService("CoreGui"))
	pcall(function()
		local _gh = (type(gethui) == "function" and gethui) or
			(type(get_hidden_gui) == "function" and get_hidden_gui) or nil
		if _gh then _addWatch(_gh()) end
	end)
	pcall(function()
		local _lp = game:GetService("Players").LocalPlayer
		if _lp then _addWatch(_lp:FindFirstChildOfClass("PlayerGui")) end
	end)
	for _, container in ipairs(_watchList) do
		for _, child in ipairs(container:GetChildren()) do _maybeHide(child) end
	end
	local _addedConns = {}
	for _, container in ipairs(_watchList) do
		table.insert(_addedConns, container.ChildAdded:Connect(_maybeHide))
	end
	local function cleanup()
		if _cleaned then return end
		_cleaned = true
		if _conn then pcall(function() _conn:Disconnect() end) end
		for _, c in ipairs(_addedConns or {}) do pcall(function() c:Disconnect() end) end
		for _, c in ipairs(_propConns or {}) do pcall(function() c:Disconnect() end) end
		for child, prevEnabled in pairs(_hidden) do
			if child and child.Parent then
				pcall(function() child.Enabled = prevEnabled end)
			end
		end
		pcall(function() gui:Destroy() end)
		pcall(function()
			local _g = (getgenv and getgenv()) or _G
			if _g._rcIntroCleanup == cleanup then _g._rcIntroCleanup = nil end
		end)
	end
	skip.MouseButton1Click:Connect(cleanup)
	pcall(function()
		local _g = (getgenv and getgenv()) or _G
		_g._rcIntroCleanup = cleanup
	end)
	task.spawn(function()
	local _probe = Instance.new("ImageLabel", card); _probe.Visible = false
	local _resolved = 0
	local _INITIAL_PRELOAD = math.min(BUFFER_SIZE * 2, FRAME_COUNT)
	do
		if not _isf("RClothesContent/.manifest_version") then
			pcall(cleanup)
			return
		end
		local batch = {}
		for i = 1, _INITIAL_PRELOAD do
			if not frameUrls[i] then
				local ok, url = pcall(_gca, string.format(PATH_FMT, i))
				if ok and type(url) == "string" and #url > 0 then frameUrls[i] = url end
			end
			if frameUrls[i] then
				batch[#batch + 1] = frameUrls[i]
				_resolved = _resolved + 1
			end
		end
		local ok = pcall(function() CP:PreloadAsync(batch) end)
		if not ok then
			for _, url in ipairs(batch) do _probe.Image = url end
		end
	end
	if _cleaned then return end
	loadStatus.Visible = false
	task.spawn(function()
		task.wait(1.5)
		for batchStart = _INITIAL_PRELOAD + 1, FRAME_COUNT, PRELOAD_BATCH do
			if _cleaned then return end
			if not _isf("RClothesContent/.manifest_version") then
				pcall(cleanup)
				return
			end
			local batch = {}
			for i = batchStart, math.min(batchStart + PRELOAD_BATCH - 1, FRAME_COUNT) do
				if not frameUrls[i] then
					local ok, url = pcall(_gca, string.format(PATH_FMT, i))
					if ok and type(url) == "string" and #url > 0 then frameUrls[i] = url end
				end
				if frameUrls[i] then
					batch[#batch + 1] = frameUrls[i]
					_resolved = _resolved + 1
				end
			end
			local ok = pcall(function() CP:PreloadAsync(batch) end)
			if not ok then
				for _, url in ipairs(batch) do _probe.Image = url end
			end
			task.wait()  
		end
		pcall(function() _probe:Destroy() end)
	end)
	if _cleaned then return end
	local _startTime = os.clock()
	local _currentFrame = 1
	local _shownLabelIdx = 1
	labels[1].ZIndex = 100
	_conn = RS.Heartbeat:Connect(function()
		if _cleaned then return end
		local elapsed = os.clock() - _startTime
		local rawFrame = math.floor(elapsed / FRAME_DT) + 1
		local targetFrame
		if LOOP then
			targetFrame = ((rawFrame - 1) % FRAME_COUNT) + 1
		else
			if rawFrame > FRAME_COUNT then cleanup(); return end
			targetFrame = rawFrame
		end
		if targetFrame ~= _currentFrame then
			_currentFrame = targetFrame
			local newSlot = ((targetFrame - 1) % BUFFER_SIZE) + 1
			if _shownLabelIdx ~= newSlot then
				labels[newSlot].ZIndex = 100
				labels[_shownLabelIdx].ZIndex = 1
				_shownLabelIdx = newSlot
			end
			local aheadFrame = targetFrame + (BUFFER_SIZE - 1)
			if LOOP then aheadFrame = ((aheadFrame - 1) % FRAME_COUNT) + 1 end
			if aheadFrame >= 1 and aheadFrame <= FRAME_COUNT then
				local aheadSlot = ((aheadFrame - 1) % BUFFER_SIZE) + 1
				local url = frameUrls[aheadFrame]
				if url and labels[aheadSlot].Image ~= url then
					labels[aheadSlot].Image = url
				end
			end
		end
	end)
	end)  
end
