	card.Position = UDim2.new(0.5, 0, 0.5, 0)
	card.Size = UDim2.new(0, 480, 0, 270)
	card.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	card.BorderSizePixel = 0
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
	local _stk = Instance.new("UIStroke", card)
	_stk.Color = Color3.fromRGB(80, 100, 180); _stk.Thickness = 1; _stk.Transparency = 0.4
	local loadStatus = Instance.new("Frame", card)
	loadStatus.AnchorPoint = Vector2.new(0.5, 0.5)
	loadStatus.Position = UDim2.new(0.5, 0, 0.5, 0)
	loadStatus.Size = UDim2.new(0, 240, 0, 14)
	loadStatus.BackgroundTransparency = 0.2
	loadStatus.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	loadStatus.BorderSizePixel = 0
	loadStatus.ZIndex = 4
	Instance.new("UICorner", loadStatus).CornerRadius = UDim.new(0, 7)
	local _stk2 = Instance.new("UIStroke", loadStatus)
	_stk2.Color = Color3.fromRGB(80, 100, 180); _stk2.Thickness = 1; _stk2.Transparency = 0.5
	local loadFill = Instance.new("Frame", loadStatus)
	loadFill.AnchorPoint = Vector2.new(0, 0.5)
	loadFill.Position = UDim2.new(0, 0, 0.5, 0)
	loadFill.Size = UDim2.new(0, 0, 1, 0)
	loadFill.BackgroundColor3 = Color3.fromRGB(110, 140, 230)
	loadFill.BorderSizePixel = 0
	loadFill.ZIndex = 5
	Instance.new("UICorner", loadFill).CornerRadius = UDim.new(0, 7)
	local loadPctLabel = Instance.new("TextLabel", loadStatus)
	loadPctLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	loadPctLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	loadPctLabel.Size = UDim2.new(1, -8, 1, 0)
	loadPctLabel.BackgroundTransparency = 1
	loadPctLabel.Font = Enum.Font.GothamMedium
	loadPctLabel.TextSize = 10
	loadPctLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
	loadPctLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	loadPctLabel.TextStrokeTransparency = 0.5
	loadPctLabel.Text = "0%"
	loadPctLabel.ZIndex = 6
	local labels = {}
	for i = 1, BUFFER_SIZE do
		local lbl = Instance.new("ImageLabel", card)
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.ScaleType = Enum.ScaleType.Stretch
