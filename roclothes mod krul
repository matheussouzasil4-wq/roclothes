	function Function.MultiplyCalculate(Base, Default)
		if not (Base and Default) then return 1, 1, 1 end
		local X = (Default.X and Default.X ~= 0) and (Base.X / Default.X) or 1
		local Y = (Default.Y and Default.Y ~= 0) and (Base.Y / Default.Y) or 1
		local Z = (Default.Z and Default.Z ~= 0) and (Base.Z / Default.Z) or 1
		return X,Y,Z
	end
