			end
			if pd.CatalogHistory and #pd.CatalogHistory > 0 then
				preset.CatalogHistory = _shallowClone(pd.CatalogHistory)
			end
			local function _propsEqual(a, b)
				if type(a) ~= type(b) then return false end
				local _ta, _tb = typeof(a), typeof(b)
				if _ta ~= _tb then return false end
				if _ta == "Color3" or _ta == "Vector3" or _ta == "CFrame" or _ta == "UDim2" or _ta == "UDim" then
					return a == b
				end
				if type(a) == "table" then
					for k, v in pairs(a) do
						if not _propsEqual(v, b[k]) then return false end
					end
					for k in pairs(b) do
						if a[k] == nil then return false end
					end
					return true
				end
				return a == b
			end
			if pd.PartList then
				local _defaultPL = Function.PartListDefault and Function.PartListDefault() or {}
				preset.MeshEdit = {}
				local _hasEdit = false
				for partName, partEntry in pairs(pd.PartList) do
					if type(partEntry) == "table" then
						local _d = _defaultPL[partName]
						local _diff = false
						if type(_d) ~= "table" then
							_diff = true
						else
							for k, v in pairs(partEntry) do
								if not _propsEqual(v, _d[k]) then
									_diff = true; break
								end
							end
						end
						if _diff then
							preset.MeshEdit[partName] = _depth2Clone(partEntry)
							_hasEdit = true
						end
					end
				end
				if not _hasEdit then preset.MeshEdit = nil end
			end
			return preset
		end
		local function _collectThumbnailIds(pd)
			local out, seen = {}, {}
			local function _push(id)
				if #out >= 8 then return end
				local s = tostring(id or ""):match("^%d+$")
				if not s or seen[s] then return end
				seen[s] = true; table.insert(out, s)
			end
			if pd.CatalogClothes then
				_push(pd.CatalogClothes.Shirt)
				_push(pd.CatalogClothes.Pants)
				_push(pd.CatalogClothes.ShirtGraphic)
			end
			if pd.CatalogAccessory then for _, v in ipairs(pd.CatalogAccessory) do _push(v) end end
			if pd.CatalogTail      then for _, v in ipairs(pd.CatalogTail)      do _push(v) end end
			return out
		end
		local function _publishOutfitToWebsite(name, preset, thumbnailIds, author)
			local PUBLISH_URL = "https://krulhub.dev/bundles/publish"
			local body = {
				name          = name,
				author        = author,
				scriptVersion = _RC_VER,
				preset        = dehydrate(preset),
				thumbnailIds  = thumbnailIds or {},
			}
			local okEnc, encoded = pcall(HS.JSONEncode, HS, body)
			if not okEnc then return false, 0, "encode failed" end
			if #encoded > 60 * 1024 then
				return false, 413, "preset too large (" .. tostring(math.floor(#encoded / 1024)) .. " KB > 60 KB)"
			end
			local req = env.http_request or (syn and syn.request) or (http and http.request)
			if not req then return false, 0, "no http_request API on this executor" end
			local okReq, res = pcall(req, {
				Url = PUBLISH_URL, Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = encoded,
			})
			if not okReq then return false, 0, tostring(res) end
			local code = tonumber(res and res.StatusCode) or 0
			local detail = ""
			local bundleId = nil
			if res and res.Body then
				local okJson, parsed = pcall(HS.JSONDecode, HS, tostring(res.Body))
				if okJson and type(parsed) == "table" then
					if parsed.bundleId then bundleId = tostring(parsed.bundleId) end
					if parsed.error then detail = tostring(parsed.error) end
					if parsed.detail then detail = detail .. " " .. tostring(parsed.detail):sub(1, 60) end
				end
			end
			if code >= 200 and code < 300 then
				return true, code, "Submitted — pending moderation. id=" .. (bundleId or "?")
			end
			if code == 0 then return false, 0, "network error" end
			return false, code, detail ~= "" and detail or ("HTTP " .. tostring(code))
		end
		local function _commitOutfitSave(name, pending)
			if not pending or not pending.pd then return nil, "no pending outfit" end
			name = (name or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then return nil, "name required" end
			if #name > 64 then name = name:sub(1, 64) end
			local finalName, suffix = name, 1
			while Bundle[finalName] do
				suffix = suffix + 1
				finalName = name .. "_" .. tostring(suffix)
				if suffix > 99 then return nil, "too many same-name bundles" end
			end
			local preset = _buildOutfitPreset(pending.pd, pending.pd.StripCategories)
			local bundleData = {Preset = preset, Personal = true}
			_finalizeImport(finalName, bundleData)
			_writeImportedBundleToDisk(finalName, bundleData)
			return finalName, nil
		end
