		local function handleBundleClick(bundleData, BButton)
			if DetectingBundle == false then
				if not PlayerData[SelectPlayer] then return end
				PlayerData[SelectPlayer]._nakedMode = nil
				local isClothingBundle = bundleData and bundleData.ClothingBundle == true
				local isPreset = bundleData and bundleData.IsPreset == true
				local isRegular = not isClothingBundle and not isPreset
				if isRegular and PlayerData[SelectPlayer].CurrentBundle == BButton.Name then
					PlayerData[SelectPlayer].CurrentBundle = "nil"
					PlayerData[SelectPlayer].CurrentClothes = {}
					scrubClothState()
					PlayerData[SelectPlayer].CurrentPreset = nil
					PlayerData[SelectPlayer].CurrentClothingBundles = {}
					_resetBundleSettableFields(SelectPlayer)
					hotSwap()
					Function.GUIUpdate()
					return
				elseif isClothingBundle and table.find(PlayerData[SelectPlayer].CurrentClothingBundles, BButton.Name) then
					if bundleData.Clothing then
						for _, clothName in pairs(bundleData.Clothing) do
							local idx = table.find(PlayerData[SelectPlayer].CurrentClothes, clothName)
							if idx then table.remove(PlayerData[SelectPlayer].CurrentClothes, idx) end
							scrubClothState(clothName)
						end
					end
					table.remove(PlayerData[SelectPlayer].CurrentClothingBundles, table.find(PlayerData[SelectPlayer].CurrentClothingBundles, BButton.Name))
					local activeName = PlayerData[SelectPlayer].CurrentBundle
					if activeName ~= "nil" and Bundle[activeName] then
						checkBundle(Bundle[activeName])
					end
					hotSwap()
					Function.GUIUpdate()
					return
				elseif isPreset and PlayerData[SelectPlayer].CurrentPreset == BButton.Name then
					PlayerData[SelectPlayer].CurrentBundle = "nil"
					PlayerData[SelectPlayer].CurrentClothes = {}
					PlayerData[SelectPlayer].CurrentPreset = nil
					PlayerData[SelectPlayer].CurrentClothingBundles = {}
					scrubClothState()
					_resetBundleSettableFields(SelectPlayer)
					hotSwap()
					Function.GUIUpdate()
					return
				end
				Function.CharacterReset(SelectPlayer)
				_resetBundleSettableFields(SelectPlayer)
				PlayerData[SelectPlayer]["PartList"] = Function.PartListDefault()
				PlayerData[SelectPlayer].LastRequestID = PlayerData[SelectPlayer].LastRequestID + 1
				local CurrentRequestID = PlayerData[SelectPlayer].LastRequestID
				if BButton.Name == "nil" then
					if PlayerData[SelectPlayer].CurrentBundle == "nil" then
						if PlayerData[SelectPlayer] and PlayerData[SelectPlayer].ExecutionMaid then
							pcall(function() PlayerData[SelectPlayer].ExecutionMaid:DoCleaning() end)
						end
						PlayerData[SelectPlayer] = Function.PlayerDataDefault()
						PlayerData[SelectPlayer].LastRequestID = CurrentRequestID
						renderRecolorList()
						if GUIObject.HPFrame and GUIObject.HPFrame.Visible then renderHPList() end
						task.delay(0,function()
							BButton:FindFirstChildOfClass("TextButton").Text = "CLEARED"
						end)
					end
				end
				if isRegular then
					PlayerData[SelectPlayer].CurrentBundle = BButton.Name
					PlayerData[SelectPlayer].CurrentPreset = nil
					PlayerData[SelectPlayer].CurrentClothingBundles = {}
					PlayerData[SelectPlayer].CurrentClothes = {}
					scrubClothState()
				elseif isPreset then
					PlayerData[SelectPlayer].CurrentPreset = BButton.Name
					PlayerData[SelectPlayer].CurrentClothingBundles = {}
				elseif isClothingBundle then
					if not table.find(PlayerData[SelectPlayer].CurrentClothingBundles, BButton.Name) then
						table.insert(PlayerData[SelectPlayer].CurrentClothingBundles, BButton.Name)
					end
				end
				local pd0 = PlayerData[SelectPlayer]
				local regularName = pd0.CurrentBundle
				if regularName and regularName ~= "nil" and Bundle[regularName] and (regularName ~= BButton.Name or not isRegular) then
					checkBundle(Bundle[regularName], CurrentRequestID)
				end
				local presetName = pd0.CurrentPreset
				if presetName and Bundle[presetName] and (presetName ~= BButton.Name or not isPreset) then
					checkBundle(Bundle[presetName], CurrentRequestID)
				end
				for _, cbName in ipairs(pd0.CurrentClothingBundles) do
					if Bundle[cbName] and (cbName ~= BButton.Name or not isClothingBundle) then
						checkBundle(Bundle[cbName], CurrentRequestID)
					end
				end
				checkBundle(bundleData, CurrentRequestID)
				do
					local _btn = GUIObject.ExecuteButton and GUIObject.ExecuteButton:FindFirstChildOfClass("TextButton")
					if _btn then
						_btn.Text = "Applying " .. tostring(BButton.Name) .. "..."
						local _watchRID = CurrentRequestID
						local _watchSP  = SelectPlayer
						task.spawn(function()
							local _t = 0
							while _t < 200 do  
								task.wait(0.05); _t = _t + 1
								local _pd = PlayerData[_watchSP]
								if not _pd or _pd.LastRequestID ~= _watchRID then return end
								if _pd.Cooldown == false then break end
							end
							local _pd = PlayerData[_watchSP]
							if _pd and _pd.LastRequestID == _watchRID and _btn and _btn.Parent then
								_btn.Text = "Execute"
							end
						end)
					end
				end
				local ep = PS:FindFirstChild(SelectPlayer)
				if ep and CurrentRequestID == PlayerData[SelectPlayer].LastRequestID then
					if ep.Character then
						local ok, err = pcall(Function.CharacterExecute, ep.Character, ep.Name, nil, CurrentRequestID)
						if not ok then warn("[RoClothes] Bundle hotSwap error:", err) end
					else
						local _capturedEP  = ep
						local _capturedRID = CurrentRequestID
						local _capturedSP  = SelectPlayer
						task.spawn(function()
							local _waited = 0
							while _capturedEP and _capturedEP.Parent and not _capturedEP.Character and _waited < 100 do
								task.wait(0.05); _waited = _waited + 1
							end
							if not (_capturedEP and _capturedEP.Parent and _capturedEP.Character) then return end
							local _pd = PlayerData[_capturedSP]
							if not _pd or _pd.LastRequestID ~= _capturedRID then return end
							local ok, err = pcall(Function.CharacterExecute, _capturedEP.Character, _capturedEP.Name, nil, _capturedRID)
							if not ok then warn("[RoClothes] Bundle hotSwap error (deferred):", err) end
						end)
					end
				end
