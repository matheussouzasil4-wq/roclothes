local function _buildHPRenderer(GUIObject, PlayerData, getSelectPlayer, Function, AllConnect, GlobalMaid)
	local HPButtons = {}
	return function()
		for i, v in pairs(GUIObject.HPListFrame:GetChildren()) do
			if not v:IsA("UIGridLayout") then
				v:Destroy()
			end
		end
		for _, v in pairs(HPButtons) do
			pcall(function() v:Disconnect() end)
			local _idx = table.find(AllConnect, v)
			if _idx then table.remove(AllConnect, _idx) end
		end
		HPButtons = {}
		local sp = getSelectPlayer()
		local pd = PlayerData[sp]
		if not pd or not pd.CurrentClothes then return end
		pd.ClothesHP = pd.ClothesHP or {}
		pd.AccessoryHP = pd.AccessoryHP or {}  
		local function _addHPRow(_label, _pdMap)
			local button = Function.ButtonCreate(_label, GUIObject.HPListFrame, false,
				{Color = Color3.new(1,1,1), Text = _label .. ": nil"})
			button:FindFirstChildOfClass("UIAspectRatioConstraint"):Destroy()
			local b = button:FindFirstChildOfClass("TextButton")
			local _cur = _pdMap(pd) and _pdMap(pd)[_label]
			if _cur and not _cur.HP then
				_pdMap(pd)[_label] = nil; _cur = nil
			end
			local switch = 0
			if _cur and _cur.HP == "TopHP" then
				switch = _cur.Inverse == true and 3 or 1
			elseif _cur and _cur.HP == "BottomHP" then
				switch = _cur.Inverse == true and 4 or 2
			end
			if switch == 1 then b.Text = _label .. ": TopHP"
			elseif switch == 2 then b.Text = _label .. ": BottomHP"
			elseif switch == 3 then b.Text = _label .. ": InverseTop"
			elseif switch == 4 then b.Text = _label .. ": InverseBottom"
			else b.Text = _label .. ": nil" end
			local _capturedLabel = _label
			local _capturedSp = sp
			local changeConnect = b.MouseButton1Click:Connect(function()
				local _sp = getSelectPlayer()
				if _sp ~= _capturedSp then return end  
				local _pd = PlayerData[_sp]
				if not _pd then return end
				local _map = _pdMap(_pd)
				if not _map then return end
				switch += 1
				if switch > 4 then switch = 0 end
				if switch == 1 then
					b.Text = _capturedLabel .. ": TopHP"
					_map[_capturedLabel] = {HP = "TopHP",    Inverse = false}
				elseif switch == 2 then
					b.Text = _capturedLabel .. ": BottomHP"
					_map[_capturedLabel] = {HP = "BottomHP", Inverse = false}
				elseif switch == 3 then
					b.Text = _capturedLabel .. ": InverseTop"
					_map[_capturedLabel] = {HP = "TopHP",    Inverse = true}
				elseif switch == 4 then
					b.Text = _capturedLabel .. ": InverseBottom"
					_map[_capturedLabel] = {HP = "BottomHP", Inverse = true}
				else
					b.Text = _capturedLabel .. ": nil"
					_map[_capturedLabel] = nil
				end
			end)
			table.insert(HPButtons, changeConnect)
			table.insert(AllConnect, changeConnect)
		end
		for _, v in pairs(pd.CurrentClothes) do
			_addHPRow(v, function(_pd)
				_pd.ClothesHP = _pd.ClothesHP or {}
				if _pd.CurrentClothes and not table.find(_pd.CurrentClothes, v) then return nil end  
				return _pd.ClothesHP
			end)
		end
		do
			local _ply = game:GetService("Players"):FindFirstChild(sp)
			local _char = _ply and _ply.Character
			if _char then
				local _seen = {}  
				for _, child in ipairs(_char:GetChildren()) do
					if child:IsA("Accessory") and not _seen[child.Name] then
						_seen[child.Name] = true
						_addHPRow(child.Name, function(_pd)
							_pd.AccessoryHP = _pd.AccessoryHP or {}
							return _pd.AccessoryHP
						end)
					end
				end
			end
		end
	end
end
