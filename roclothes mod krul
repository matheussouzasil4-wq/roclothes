						local _hp = ctx.Clothes[clothName].HP
						if _hp == 1 then
							pd.ClothesHP[clothName] = {HP = "TopHP",    Inverse = false}
						elseif _hp == 2 then
							pd.ClothesHP[clothName] = {HP = "BottomHP", Inverse = false}
						elseif _hp == 3 then
