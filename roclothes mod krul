					PlayerData[SelectPlayer].ClothesHP[v] = nil
					if Clothes[v] and Clothes[v]["HP"] then
						local _hp = Clothes[v].HP
						local _pd = PlayerData[SelectPlayer]
						if _hp == 1 or _hp == 2 or _hp == 3 or _hp == 4 then
							local _ref = (_hp == 1 or _hp == 3) and tonumber(_pd.TopHP) or tonumber(_pd.BottomHP)
							_pd.ClothesHP[v] = {Threshold = _ref or 50, Inverse = (_hp == 3 or _hp == 4)}
						elseif _hp and _hp ~= 0 then
							_pd.ClothesHP[v] = {Threshold = tonumber(_pd.TopHP) or 50, Inverse = false}
						end
					end
					for _, c in pairs(Clothes[v].Weld or {}) do
						if PartList[c] and PartList[c].Recolor then
							if not PlayerData[SelectPlayer].ClothesRecolor[v] then
								PlayerData[SelectPlayer].ClothesRecolor[v] = {}
							end
							break
						end
					end
				end
			end
			if v.Recolor then
				for cloth, colors in pairs(v.Recolor) do
					do local _safe = _sanitizeClothesRecolor(colors); if _safe then PlayerData[SelectPlayer].ClothesRecolor[cloth] = _safe end end 
				end
			end
			if v.MeshEdit then
				local _selPL = PlayerData[SelectPlayer] and PlayerData[SelectPlayer].PartList
				for Name, Property in pairs(v.MeshEdit) do
					for PropertyName, v in pairs(Property) do
						if PropertyName == "CockScale" then
							if type(v) == "number" and v == v and math.abs(v) ~= math.huge then
								PlayerData[SelectPlayer].CockScale = math.clamp(v, 0.1, 10)
							end
						elseif PropertyName == "Color" then
							if _selPL and _selPL[Name] and _selPL[Name][PropertyName]
							   and type(v) == "table"
							   and type(v.R) == "number" and type(v.G) == "number" and type(v.B) == "number"
							   and v.R == v.R and v.G == v.G and v.B == v.B then  
								local RGB = Function.StringTo(tostring(v.R*255 .."," ..v.G*255 ..","..v.B*255), "RGB")
								_selPL[Name][PropertyName].Color = RGB
							end
						else
							if _selPL and _selPL[Name] then
								local _safe, _ok = Function.SanitizeMeshEditValue(PropertyName, v)
								if _ok then _selPL[Name][PropertyName] = _safe end
							end
						end
					end
				end
			end
			if v.HPClothes then
				local _pd = PlayerData[SelectPlayer]
				for name, val in pairs(v.HPClothes) do
					if type(val) == "table" and val.Threshold == nil and (val.HP or val.Inverse ~= nil or val.Type) then
						local _ref = (val.HP == "TopHP") and tonumber(_pd.TopHP) or tonumber(_pd.BottomHP)
						_pd.ClothesHP[name] = {Threshold = _ref or 50, Inverse = val.Inverse == true}
