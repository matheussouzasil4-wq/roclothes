		end
		if keyword and keyword ~= "" then
			table.insert(p, "Keyword=" .. HS:UrlEncode(keyword))
		end
		if cursor and cursor ~= "" then
			table.insert(p, "Cursor=" .. HS:UrlEncode(cursor))
		end
		if filters then
			if filters.freeOnly then
				p[#p] = nil  
				for _i = #p, 1, -1 do
					if p[_i] == "IncludeNotForSale=true" then table.remove(p, _i) end
				end
				table.insert(p, "MaxPrice=0")
			else
				if tonumber(filters.minPrice) then table.insert(p, "MinPrice=" .. tostring(tonumber(filters.minPrice))) end
				if tonumber(filters.maxPrice) then table.insert(p, "MaxPrice=" .. tostring(tonumber(filters.maxPrice))) end
			end
			if filters.creator and filters.creator ~= "" then
				table.insert(p, "CreatorName=" .. HS:UrlEncode(filters.creator))
			end
		end
		local query = table.concat(p, "&")
		local data = Function.CatalogHttpGet(_CATALOG_HOST .. "/v1/search/items/details?" .. query)
		local hasDetails = data and data.data and #data.data > 0
		if not hasDetails then
			data = Function.CatalogHttpGet(_CATALOG_HOST .. "/v1/search/items?" .. query)
		end
		if not data then return nil, nil, "no response" end
		if type(data.errors) == "table" and data.errors[1] then
			return nil, nil, "api error: " .. tostring(data.errors[1].message)
		end
		if type(data.data) ~= "table" then return nil, nil, "no data array" end
		local items = {}
		for _, d in ipairs(data.data) do
			local id = d.id or d.Id
			local n = d.name or d.Name or _catalogNameCache[id]
			local pr = d.priceInRobux or d.Price or _catalogPriceCache[id]
			local at = d.assetType or d.AssetType or _catalogTypeCache[id]
			table.insert(items, {
				id           = id,
				itemType     = d.itemType or d.ItemType or "Asset",
				name         = n or ("ID " .. tostring(id)),
				priceInRobux = pr,
				assetType    = at,
				creator      = d.creatorName or d.creatorTargetName or "",
			})
		end
		if _cacheKey then Function._CB_pagePut(_cacheKey, items, data.nextPageCursor) end
		return items, data.nextPageCursor, nil
	end
	function Function.CatalogFetchAssetDetails(id)
		local d
		for attempt = 1, 2 do
			d = Function.CatalogHttpGet(_ECONOMY_HOST .. "/v2/assets/" .. tostring(id) .. "/details")
			if d and not d.errors then break end
			if attempt == 1 then task.wait(1) end
		end
		if not d or d.errors then return nil end
		local out = {name = d.Name, price = d.PriceInRobux, assetType = d.AssetTypeId}
		local function _capCache(_t)
			local _n = 0
			for _ in pairs(_t) do _n = _n + 1 end
			if _n >= _CATALOG_CACHE_MAX then
				for k in pairs(_t) do _t[k] = nil; break end
			end
		end
		if out.name      then _capCache(_catalogNameCache);  _catalogNameCache[id]  = out.name end
		if out.price     then _capCache(_catalogPriceCache); _catalogPriceCache[id] = out.price end
		if out.assetType then
			_capCache(_catalogTypeCache)
			_catalogTypeCache[id]  = out.assetType
			Function._catalogAssetTypeCache[tonumber(id) or id] = out.assetType
			Function._catalogAssetTypeCacheDirty = true
		end
		return out
	end
