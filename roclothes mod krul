	local FRAME_COUNT = 591
	local FRAME_FPS   = 12
	local FRAME_DT    = 1 / FRAME_FPS
	local PATH_FMT    = "RClothesContent/intro/frame_%04d.webp"
	local LOOP        = true
	local PRELOAD_BATCH = 10  
	local BUFFER_SIZE = 24  
	local _gca = getcustomasset or getsynasset
	local _isf = isfile
	if not (_gca and _isf) then return end  
	if not _isf(string.format(PATH_FMT, 1)) then return end  
	if not _isf("RClothesContent/.manifest_version") then return end
	local frameUrls = {}
	for i = 1, BUFFER_SIZE do
