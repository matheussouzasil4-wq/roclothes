	function Function.CharacterConnection(Player)
		local CharacterConnect = Player.CharacterAdded:Connect(function(Character)
			if PlayerData[Player.Name] ~= nil and PlayerData[Player.Name].AutoExecute then
				local waitCount = 0
				while not Function.CharacterIsBuilt(Character) do
					task.wait(0.1)
					waitCount = waitCount + 1
					if waitCount > 50 then return end
				end
				Function.PlayerDataAdd(Player.Name)
				PlayerData[Player.Name].LastRequestID = PlayerData[Player.Name].LastRequestID + 1
				local autoID = PlayerData[Player.Name].LastRequestID
				local delay = tonumber(PlayerData[Player.Name].DelayTime) or 0
				if delay < 0 then delay = 0 end
				if delay > 30 then delay = 30 end  
				if delay > 0 then task.wait(delay) end
				if not PlayerData[Player.Name] then return end
				if not PlayerData[Player.Name].AutoExecute then return end
				if PlayerData[Player.Name].LastRequestID ~= autoID then return end
				if not Character or not Character.Parent then return end
				local ok, err = pcall(Function.CharacterExecute, Character, Player.Name, nil, autoID)
				if not ok then
					warn("[RoClothes] Auto-execute failed:", err)
					if PlayerData[Player.Name] then
						PlayerData[Player.Name]["Cooldown"] = false
					end
				end
			end
		end)
		GlobalMaid:Give(CharacterConnect)
		System._charAddedConn = CharacterConnect
	end
	local function _validatePresetValue(setting, value)
		if setting == "CatalogClothes" then
			return type(value) == "table"
				and (value.Shirt == nil or type(value.Shirt) == "string" or type(value.Shirt) == "number")
				and (value.Pants == nil or type(value.Pants) == "string" or type(value.Pants) == "number")
				and (value.ShirtGraphic == nil or type(value.ShirtGraphic) == "string" or type(value.ShirtGraphic) == "number")
		elseif setting == "CatalogOutfitId" then
			return type(value) == "string" and #value <= 32 and value:match("^%d*$") ~= nil
		elseif setting == "SkinTone" or setting == "NippleColor" or setting == "BundleBodyColor" then
			return typeof(value) == "Color3"
		elseif setting == "BreastsType" then
			return type(value) == "number" and value >= 1 and value <= MaxBreastsType
				and value == math.floor(value)
		elseif setting == "TorsoType" then
			return type(value) == "number" and value >= 1 and value <= MaxTorsoType
				and value == math.floor(value)
		elseif setting == "ArmType" then
			return type(value) == "number" and value >= 1 and value <= MaxArmType
				and value == math.floor(value)
		elseif setting == "LegsType" then
			return type(value) == "number" and value >= 1 and value <= MaxLegsType
				and value == math.floor(value)
		elseif setting == "ButtType" then
			return type(value) == "number" and value >= 1 and value <= MaxButtType
				and value == math.floor(value)
		elseif setting == "BreastsScale" or setting == "ButtsScale"
			or setting == "LegsScale" or setting == "CockScale"
			or setting == "BreastsStiffness" or setting == "BreastsDamping"
			or setting == "ButtsStiffness" or setting == "ButtsDamping"
			or setting == "CockStiffness" or setting == "CockDamping"
			or setting == "Volume"
		then
			return type(value) == "number" and value == value
				and value >= 0 and value <= 10
		elseif setting == "StripCategories" then
			if type(value) ~= "table" then return false end
			local _allowed = {Hat=true,Hair=true,Face=true,Neck=true,Shoulder=true,Front=true,Back=true,Waist=true}
			for k, vv in pairs(value) do
				if not (_allowed[k] and type(vv) == "boolean") then return false end
			end
			return true
		elseif setting == "AutoStripOnRip" then
			return type(value) == "boolean"
		elseif setting == "StripOnRipMap" then
			if type(value) ~= "table" then return false end
			local _vals = {None=true,Top=true,Bottom=true,Both=true}
			local _count = 0
			for k, vv in pairs(value) do
				_count = _count + 1
				if _count > 200
					or type(k) ~= "string" or #k == 0 or #k > 64
					or k:find("[%c]") ~= nil
					or not _vals[vv]
				then
					return false
				end
			end
			return true
		elseif setting == "CatalogUsername" then
			return type(value) == "string" and #value <= 32 and value:match("^[%w_]*$") ~= nil
		elseif setting == "CatalogRemove" then
			if type(value) ~= "table" then return false end
			local _n = 0
			for k, vv in pairs(value) do
				_n = _n + 1
				if _n > 256 then return false end  
				if type(k) ~= "number" or k ~= math.floor(k) then return false end
				local _id = tonumber(vv)
				if not _id or _id <= 0 or _id ~= math.floor(_id) or _id >= 2^53 then return false end
			end
			return true
		elseif setting == "CatalogHistory" then
			if type(value) ~= "table" then return false end
			local _n = 0
			for k, vv in pairs(value) do
				_n = _n + 1
				if _n > 64 then return false end  
				if type(k) ~= "number" or k ~= math.floor(k) then return false end
				local _id = tonumber(vv)
				if not _id or _id <= 0 or _id ~= math.floor(_id) or _id >= 2^53 then return false end
			end
			return true
		elseif setting == "MeshEdit" then
			if type(value) ~= "table" then return false end
			local _n = 0
			for k, vv in pairs(value) do
				_n = _n + 1
				if _n > 256 then return false end
				if type(k) ~= "string" or #k > 64 then return false end
				if type(vv) ~= "table" then return false end
			end
			return true
		end
		return true
	end
	local function _sanitizeGizmoOffsets(input)
		if type(input) ~= "table" then return {} end
		local _safe = {}
		local function _isFiniteNum(x)
			return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
		end
		for k, v in pairs(input) do
			if type(k) == "string" and #k <= 128 and type(v) == "table" then
				local _entry = {}
				local _ok = true
				for fk, fv in pairs(v) do
					if type(fk) ~= "string" or #fk > 64 then _ok = false; break end
					if fk == "RotCF" or fk == "baseC0" or fk == "baseC1" then
						if typeof(fv) == "CFrame" then _entry[fk] = fv end
					else
						if not _isFiniteNum(fv) then _ok = false; break end
						if fv < -100 or fv > 100 then _ok = false; break end
						_entry[fk] = fv
					end
				end
				if _ok then _safe[k] = _entry end
			end
		end
		return _safe
	end
	local function _sanitizeClothesRecolor(colors)
		if type(colors) ~= "table" then return nil end
		local _safe = {}
		local _anyValid = false
		for _, slot in ipairs({"Primary", "Secondary", "Tertiary"}) do
			local v = colors[slot]
			if typeof(v) == "Color3" then
				_safe[slot] = v
				_anyValid = true
			elseif v == "nil" then
				_safe[slot] = "nil"
				_anyValid = true
			end
		end
		if not _anyValid then return nil end
		return _safe
	end
